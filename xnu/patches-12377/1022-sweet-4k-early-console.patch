+#define SWEET_EARLY_FB_BLOCKS   1
+#else
+#define SWEET_EARLY_FB_PA       0x9d400000
+#define SWEET_EARLY_FB_BLOCKS   6
+#endif
+
+#ifndef __ASSEMBLER__
 #include <stdarg.h>
 #include <stdint.h>
 
 #if defined(SWEET)
