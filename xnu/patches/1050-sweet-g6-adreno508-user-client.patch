+#define SWEET_MSM_INFO_SET_IOVA         4       /* only before the BO was ever submitted; range must be free, 4 KiB aligned */
+#define SWEET_MSM_INFO_GET_FLAGS        5
+
+#define SWEET_MSM_PREP_READ             0x01
+#define SWEET_MSM_PREP_WRITE            0x02
