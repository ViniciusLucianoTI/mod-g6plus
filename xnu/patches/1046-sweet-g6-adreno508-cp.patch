+static void
+a5_hw_init_regs(void)
+{
+	gw(A5_VBIF_ROUND_ROBIN_QOS_ARB, 0x00000003);
+	gw(A5_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	gw(A5_RBBM_AHB_CNTL0, 0x00000001);
+	gw(A5_RBBM_INTERFACE_HANG_INT_CNTL, (1u << 30) | 0xffff);
+	gw(A5_RBBM_PERFCTR_CNTL, 0x01);
+	gw(A5_CP_PERFCTR_CP_SEL_0, 0);
+	gw(A5_RBBM_PERFCTR_RBBM_SEL_0, 6);
+	gw(A5_UCHE_CACHE_WAYS, 0x02);
+	gw(A5_UCHE_TRAP_BASE_LO, 0xffff0000);
+	gw(A5_UCHE_TRAP_BASE_HI, 0x0001ffff);
+	gw(A5_UCHE_WRITE_THRU_BASE_LO, 0xffff0000);
+	gw(A5_UCHE_WRITE_THRU_BASE_HI, 0x0001ffff);
+	gw(A5_UCHE_GMEM_RANGE_MIN_LO, 0x00100000);
+	gw(A5_UCHE_GMEM_RANGE_MIN_HI, 0);
+	gw(A5_UCHE_GMEM_RANGE_MAX_LO, 0x00100000 + A5_GMEM_BYTES - 1);
+	gw(A5_UCHE_GMEM_RANGE_MAX_HI, 0);
+	/* A506/A508 values */
+	gw(A5_CP_MEQ_THRESHOLDS, 0x20);
+	gw(A5_CP_MERCIU_SIZE, 0x400);
+	gw(A5_CP_ROQ_THRESHOLDS_2, 0x40000030);
+	gw(A5_CP_ROQ_THRESHOLDS_1, 0x20100d0a);
+	gw(A5_PC_DBG_ECO_CNTL, (0x100u << 11) | (0x100u << 22));
+	gw(A5_RB_DBG_ECO_CNTL, gr(A5_RB_DBG_ECO_CNTL) | (1u << 9));
+	gw(A5_UCHE_MODE_CNTL, 1u << 29);
+	gw(A5_CP_CHICKEN_DBG, 0x02000000);
+	gw(A5_RBBM_AHB_CNTL1, 0xa6ffffff);
+	/* hardware clock gating (a50x_hwcg) is left off for the bring-up */
+	gw(A5_RBBM_AHB_CNTL2, 0x0000003f);
+	gw(A5_TPL1_MODE_CNTL, 1u << 7);         /* highest bank bit */
+	gw(A5_RB_MODE_CNTL, 1u << 1);
+	gw(A5_VPC_DBG_ECO_CNTL, gr(A5_VPC_DBG_ECO_CNTL) | (1u << 10));
+	gw(A5_CP_PROTECT_CNTL, 0x00000007);
+	gw(A5_CP_PROTECT(0), A5_PROTECT_RW(0x04, 2));
+	gw(A5_CP_PROTECT(1), A5_PROTECT_RW(0x08, 3));
+	gw(A5_CP_PROTECT(2), A5_PROTECT_RW(0x10, 4));
+	gw(A5_CP_PROTECT(3), A5_PROTECT_RW(0x20, 5));
+	gw(A5_CP_PROTECT(4), A5_PROTECT_RW(0x40, 6));
+	gw(A5_CP_PROTECT(5), A5_PROTECT_RW(0x80, 6));
+	gw(A5_CP_PROTECT(6), A5_PROTECT_RW(A5_RBBM_SECVID_TSB_TRUSTED_BASE_LO, 4));
+	gw(A5_CP_PROTECT(7), A5_PROTECT_RW(A5_RBBM_SECVID_TRUST_CNTL, 1));
+	gw(A5_CP_PROTECT(8), A5_PROTECT_RW(0x800, 6));
+	gw(A5_CP_PROTECT(9), A5_PROTECT_RW(0x840, 3));
+	gw(A5_CP_PROTECT(10), A5_PROTECT_RW(0x880, 5));
+	gw(A5_CP_PROTECT(11), A5_PROTECT_RW(0xaa0, 0));
+	gw(A5_CP_PROTECT(12), A5_PROTECT_RW(0xcc0, 0));
+	gw(A5_CP_PROTECT(13), A5_PROTECT_RW(0xcf0, 1));
+	gw(A5_CP_PROTECT(14), A5_PROTECT_RW(0xe68, 3));
+	gw(A5_CP_PROTECT(15), A5_PROTECT_RW(0xe70, 4));
+	gw(A5_CP_PROTECT(16), A5_PROTECT_RW(0xe80, 4));
+	gw(A5_CP_PROTECT(17), A5_PROTECT_RW(0x10000, 15));
+	gw(A5_RBBM_SECVID_TSB_CNTL, 0);
+	gw(A5_RBBM_SECVID_TSB_TRUSTED_BASE_LO, 0);
+	gw(A5_RBBM_SECVID_TSB_TRUSTED_BASE_HI, 0);
+	gw(A5_RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	gw(A5_CP_ADDR_MODE_CNTL, 1);
+	gw(A5_VSC_ADDR_MODE_CNTL, 1);
+	gw(A5_GRAS_ADDR_MODE_CNTL, 1);
+	gw(A5_RB_ADDR_MODE_CNTL, 1);
+	gw(A5_PC_ADDR_MODE_CNTL, 1);
+	gw(A5_HLSQ_ADDR_MODE_CNTL, 1);
+	gw(A5_VFD_ADDR_MODE_CNTL, 1);
+	gw(A5_VPC_ADDR_MODE_CNTL, 1);
+	gw(A5_UCHE_ADDR_MODE_CNTL, 1);
+	gw(A5_SP_ADDR_MODE_CNTL, 1);
+	gw(A5_TPL1_ADDR_MODE_CNTL, 1);
+	gw(A5_RBBM_SECVID_TSB_ADDR_MODE_CNTL, 1);
+	/* ADRENO_QUIRK_LMLOADKILL_DISABLE (A508) */
+	gw(A5_VPC_DBG_ECO_CNTL, gr(A5_VPC_DBG_ECO_CNTL) | (1u << 23));
+	gw(A5_HLSQ_DBG_ECO_CNTL, gr(A5_HLSQ_DBG_ECO_CNTL) & ~(1u << 18));
+}
