+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * sweetearlyfb=2 (patches 1025/1026): kprintf goes to the serial port only, which the SDM630 phone does not have;
+ * mirror it onto the panel through the synchronous early console too (cpu_start, initCPU, ... trails).
+ */
+extern int sweet_early_mirror_enabled(void);
+extern void sweet_early_mirror(const char *s, int n);
+static void
+sweet_kprintf_mirror_putc(char c)
+{
+	sweet_early_mirror(&c, 1);
+}
+#endif
+
