+extern int _sweet_lse_cas(user_addr_t addr, uint64_t expected, uint64_t desired, uint64_t *old, uint32_t size);
+extern int _sweet_lse_cas128(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi, uint64_t des_lo, uint64_t des_hi,
+    uint64_t old[2]);
+extern int _sweet_lse_load(user_addr_t addr, uint64_t *val, uint32_t size);
 
