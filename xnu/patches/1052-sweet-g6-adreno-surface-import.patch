From 608e7c95b678d082976dab98045fe53f1c4bb5d2 Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Fri, 13 Nov 2026 00:25:32 -0300
Subject: [PATCH] sweet g6: SweetAdreno user client up to 11215 0187 (driver
 lock, epoch, IOSurface import: SURFACE_BO, abi minor 1)

---
 bsd/dev/sweet_a508.c              |  29 ++++
 iokit/Kernel/arm/SweetAdreno.cpp  | 224 +++++++++++++++++++++++-------
 iokit/Kernel/arm/SweetAdrenoABI.h |  24 +++-
 3 files changed, 225 insertions(+), 52 deletions(-)

diff --git a/bsd/dev/sweet_a508.c b/bsd/dev/sweet_a508.c
index 96a77cf20..7aad3666e 100644
--- a/bsd/dev/sweet_a508.c
+++ b/bsd/dev/sweet_a508.c
@@ -29,6 +29,7 @@
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
 #include <kern/kalloc.h>
+#include <kern/locks.h>
 #include <vm/pmap.h>
 #include <vm/vm_kern.h>
 #include "sweet_board.h"
@@ -699,6 +700,34 @@ uint32_t sweet_gpu_fence_last(void);
 void sweet_gpu_mark_lost(void);
 void sweet_gpu_report(const char *why);
 void sweet_gpu_debug(uint32_t *w);
+void sweet_gpu_lock(void);
+void sweet_gpu_unlock(void);
+uint32_t sweet_gpu_epoch(void);
+
+/*
+ * The driver's lock (SweetAdreno.cpp takes it around every call since 11215's 0186; there it also serializes the
+ * power governor and recovery, which do not exist here yet) and the recovery epoch (never changes: no recovery).
+ */
+static LCK_GRP_DECLARE(a5_lck_grp, "sweet_a508");
+static LCK_MTX_DECLARE(a5_lck, &a5_lck_grp);
+
+void
+sweet_gpu_lock(void)
+{
+	lck_mtx_lock(&a5_lck);
+}
+
+void
+sweet_gpu_unlock(void)
+{
+	lck_mtx_unlock(&a5_lck);
+}
+
+uint32_t
+sweet_gpu_epoch(void)
+{
+	return 1;
+}
 
 static void
 a5_pte_wr(volatile uint64_t *slot, uint64_t v)
diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
index b869464a8..94334b76d 100644
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -48,6 +48,9 @@ void sweet_gpu_iova_free(uint64_t iova, uint64_t size);
 bool sweet_gpu_vm_map(uint64_t iova, uint64_t pa, bool readonly);
 void sweet_gpu_vm_unmap(uint64_t iova, uint64_t size);
 void sweet_gpu_vm_flush(void);
+void sweet_gpu_lock(void);
+void sweet_gpu_unlock(void);
+uint32_t sweet_gpu_epoch(void);
 bool sweet_gpu_check_fault(void);
 void sweet_gpu_cache_sync(void *va, size_t len);
 uint32_t sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned count);
@@ -70,8 +73,11 @@ void SweetAdrenoPublish(void);
 #define IOVA_UNSET              0
 #define GPU_PAGE                0x1000ull       /* SMMU granule; never PAGE_SIZE (16 KiB) */
 
-static IOLock *gAdrenoLock;
-static uint32_t gAdrenoClients;
+static IOLock *gClientsLock;           /* only the pid list below; the device lock is sweet_gpu_lock() */
+static struct {
+	int32_t pid;
+	uint32_t count;
+} gClientPids[32];
 
 struct sweet_gem {
 	IOMemoryDescriptor       *md;           /* NULL: free slot */
@@ -97,6 +103,7 @@ class SweetAdrenoUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(SweetAdrenoUserClient);
 
 	task_t            fTask;
+	int32_t           fPid;
 	struct sweet_gem *fGems;
 	uint32_t          fNextGem;
 	uint64_t          fQueues;      /* bit n = submitqueue id n open (id 0 = default, always) */
@@ -141,6 +148,34 @@ OSDefineMetaClassAndStructors(AGXDeviceUserClient, SweetAdrenoUserClient);
 
 /* ------------------------------------------------------------------ */
 
+/* "pid,pid" of the open clients (with a trailing "+" when the list is cut) and their number; for kern.sweet_gpu. */
+extern "C" void
+SweetAdrenoClients(char *buf, size_t size, uint32_t *count)
+{
+	size_t n = 0;
+
+	buf[0] = 0;
+	*count = 0;
+	if (gClientsLock == NULL) {
+		strlcpy(buf, "-", size);
+		return;
+	}
+	IOLockLock(gClientsLock);
+	for (unsigned i = 0; i < 32; i++) {
+		if (gClientPids[i].count) {
+			*count += gClientPids[i].count;
+			int w = snprintf(buf + n, size - n, "%s%d", n ? "," : "", gClientPids[i].pid);
+			if (w > 0 && n + (size_t)w < size) {
+				n += (size_t)w;
+			}
+		}
+	}
+	IOLockUnlock(gClientsLock);
+	if (n == 0) {
+		strlcpy(buf, "-", size);
+	}
+}
+
 extern "C" void
 SweetAdrenoPublish(void)
 {
@@ -149,10 +184,10 @@ SweetAdrenoPublish(void)
 	if (!sweet_gpu_ready()) {
 		return;
 	}
-	if (gAdrenoLock == NULL) {
-		gAdrenoLock = IOLockAlloc();
+	if (gClientsLock == NULL) {
+		gClientsLock = IOLockAlloc();
 	}
-	if (gAdrenoLock == NULL) {
+	if (gClientsLock == NULL) {
 		return;
 	}
 	(void)PE_parse_boot_argn("sweetgpuuc", &agx, sizeof(agx));
@@ -184,10 +219,28 @@ SweetAdrenoUserClient::initWithTask(task_t owningTask, void *securityID, UInt32
 	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
 		return false;
 	}
-	if (!sweet_gpu_ready() || gAdrenoLock == NULL) {
+	if (!sweet_gpu_ready() || gClientsLock == NULL) {
 		return false;
 	}
 	fTask = owningTask;
+	fPid = proc_selfpid();
+	IOLockLock(gClientsLock);
+	int slot = -1;
+	for (int i = 0; i < 32 && slot < 0; i++) {
+		if (gClientPids[i].count && gClientPids[i].pid == fPid) {
+			slot = i;
+		}
+	}
+	for (int i = 0; i < 32 && slot < 0; i++) {
+		if (!gClientPids[i].count) {
+			slot = i;
+			gClientPids[i].pid = fPid;
+		}
+	}
+	if (slot >= 0) {
+		gClientPids[slot].count++;
+	}
+	IOLockUnlock(gClientsLock);
 	fGems = (struct sweet_gem *)IOMallocZeroData(sizeof(struct sweet_gem) * GEM_MAX);
 	return fGems != NULL;
 }
@@ -205,9 +258,17 @@ SweetAdrenoUserClient::free()
 IOReturn
 SweetAdrenoUserClient::clientClose(void)
 {
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	if (!fClosed) {
 		fClosed = true;
+		IOLockLock(gClientsLock);
+		for (unsigned i = 0; i < 32; i++) {
+			if (gClientPids[i].count && gClientPids[i].pid == fPid) {
+				gClientPids[i].count--;
+				break;
+			}
+		}
+		IOLockUnlock(gClientsLock);
 		if (fGems != NULL) {
 			for (uint32_t i = 0; i < GEM_MAX; i++) {
 				if (fGems[i].md != NULL) {
@@ -216,7 +277,7 @@ SweetAdrenoUserClient::clientClose(void)
 			}
 		}
 	}
-	IOLockUnlock(gAdrenoLock);
+	sweet_gpu_unlock();
 	terminate();
 	return kIOReturnSuccess;
 }
@@ -263,6 +324,7 @@ bool
 SweetAdrenoUserClient::waitFence(uint32_t fence, uint64_t ns)
 {
 	uint64_t began = mach_absolute_time(), limit, cap, early;
+	uint32_t epoch = sweet_gpu_epoch();
 
 	if (fence == 0 || sweet_gpu_fence_done(fence)) {
 		return true;
@@ -278,6 +340,9 @@ SweetAdrenoUserClient::waitFence(uint32_t fence, uint64_t ns)
 		if (sweet_gpu_fence_done(fence)) {
 			return true;
 		}
+		if (epoch != sweet_gpu_epoch()) {
+			return false;                   /* the GPU was reset under this wait: the work is void */
+		}
 		if (sweet_gpu_check_fault() || !sweet_gpu_ready()) {
 			return false;                   /* the CP faulted: fail now instead of waiting for the timeout */
 		}
@@ -292,13 +357,13 @@ SweetAdrenoUserClient::waitFence(uint32_t fence, uint64_t ns)
 			}
 			return false;
 		}
-		IOLockUnlock(gAdrenoLock);
+		sweet_gpu_unlock();
 		if (waited < early) {           /* short jobs: spin; longer ones: sleep a millisecond at a time */
 			delay_for_interval(100, NSEC_PER_USEC);
 		} else {
 			IOSleep(1);
 		}
-		IOLockLock(gAdrenoLock);
+		sweet_gpu_lock();
 	}
 }
 
@@ -399,7 +464,7 @@ SweetAdrenoUserClient::gemNew(struct sweet_msm_gem_new *r)
 	bzero(kva, (size_t)size);
 	sweet_gpu_cache_sync(kva, (size_t)size);
 
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	IOReturn ret = kIOReturnNoResources;
 	if (!sweet_gpu_ready()) {
