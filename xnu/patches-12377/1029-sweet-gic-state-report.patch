+#if defined(SWEET)
+/*
+ * patch 1029: SDM630 hang diagnostics. One line of GIC + virtual timer state for this CPU, printed with
+ * kprintf (shown on the panel with sweetearlyfb=2). Offsets: GICv3 architecture (GICR SGI frame +0x10000).
+ */
+extern void kprintf(const char *fmt, ...);
+void sweet_gic_report(const char *tag);
+void
+sweet_gic_report(const char *tag)
+{
+	if (!gicd_base || !gicr_base) {
+		kprintf("SWEET GIC[%s]: not mapped\n", tag);
+		return;
+	}
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	kprintf("SWEET GIC[%s]: D_CTLR=0x%x R=%#lx WAKER=0x%x GRP=0x%x EN=0x%x PEND=0x%x ACT=0x%x\n", tag,
+	    gicd_read32(GICD_CTLR), (unsigned long)(gicr_pe_base - gicr_base), gicr_read32(GICR_WAKER),
+	    gicr_read32(0x10080), gicr_read32(0x10100), gicr_read32(0x10200), gicr_read32(0x10300));
+	kprintf("SWEET GIC[%s]: IGRPEN1=0x%llx CTLR=0x%llx HPPIR1=0x%llx CNTV_CTL=0x%llx CVAL=0x%llx VCT=0x%llx\n", tag,
+	    __builtin_arm_rsr64("S3_0_C12_C12_7"), __builtin_arm_rsr64("S3_0_C12_C12_4"),
+	    __builtin_arm_rsr64("S3_0_C12_C12_2"), __builtin_arm_rsr64("CNTV_CTL_EL0"),
+	    __builtin_arm_rsr64("CNTV_CVAL_EL0"), __builtin_arm_rsr64("CNTVCT_EL0"));
+}
+#endif /* SWEET */
+
