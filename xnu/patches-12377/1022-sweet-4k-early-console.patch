+#define EARLY_BLOCK_PA ((uint64_t)SWEET_EARLY_FB_PA)
 #if __ARM_16K_PG__
-#define EARLY_FB_MAPPED 1u
+#define EARLY_BLOCK_SIZE 0x2000000ull
+volatile uint32_t sweet_early_fb_mapped = 1;
+static unsigned int early_width = 1080u, early_height = 2400u, early_stride = 4320u / 4;
 #else
-#define EARLY_FB_MAPPED 0u
+#define EARLY_BLOCK_SIZE (SWEET_EARLY_FB_BLOCKS * 0x200000ull)
+volatile uint32_t sweet_early_fb_mapped = 0;     /* start.s stores 1 (physical address, MMU off) */
+static unsigned int early_width = 1080u, early_height = 2160u, early_stride = 4320u / 4;
 #endif
+#define EARLY_FB_MAPPED sweet_early_fb_mapped
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)EARLY_BLOCK_PA;
-static unsigned int early_width = 1080u, early_height = 2400u, early_stride = 4320u / 4;
 static uint64_t early_off;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH early_width
@@ -72,6 +72,9 @@ sweet_early_clear_row(void)
