+/*
+ * sweetearlyfb=2 (patch 1025): also MIRROR every console_write() byte onto the panel, synchronously, for
+ * the whole session (the -v boot log renderer only paints from a 33 ms thread_call, so whatever was
+ * printed just before a hard hang never reaches the screen). Survives sweet_early_disable().
+ */
+static unsigned int early_mirror;
+static volatile unsigned int early_mirror_busy;
 
 static void
 sweet_early_clear_row(void)
@@ -192,6 +199,11 @@ sweet_early_set_cmdline(const char *cmdline)
 			early_screen = 1;       /* drawing still needs EARLY_FB_MAPPED */
 			return;
 		}
+		if (k == sizeof(key) - 2 && cmdline[i + k] == '2' && (i == 0 || cmdline[i - 1] == ' ')) {
+			early_screen = 1;       /* "sweetearlyfb=2": draw and mirror the console */
+			early_mirror = 1;
+			return;
+		}
 	}
 }
 
@@ -234,6 +246,23 @@ sweet_early_relocate(uint64_t base)
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
 
+/* console_write() hook (serial_console.c): see early_mirror. Drops bytes rather than nesting. */
+void
+sweet_early_mirror(const char *s, int n)
+{
+	if (!early_mirror || !EARLY_FB_MAPPED || early_panicking || s == NULL) {
+		return;
+	}
+	if (__atomic_exchange_n(&early_mirror_busy, 1u, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	for (int i = 0; i < n; i++) {
+		sweet_early_draw(s[i]);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	__atomic_store_n(&early_mirror_busy, 0u, __ATOMIC_RELEASE);
+}
