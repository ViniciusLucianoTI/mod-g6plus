+static bool
+a5_load_ucode(const char *prop, const char *file, uint32_t gpu_va, uint32_t max)
+{
+	void *fw = NULL;
+	size_t len = 0;
+	if (!sweet_a630_fw_get(prop, file, &fw, &len) || len < 8 || len - 4 > max) {
+		printf("SWEET GPU: %s missing or too large (%lu bytes)\n", file, (unsigned long)len);
+		return false;
+	}
+	/* Linux adreno_fw_create_bo(): the first word is a header, the rest is what the CP executes */
+	const uint8_t *src = (const uint8_t *)fw + 4;
+	volatile uint32_t *dst = a5_cpu(gpu_va);
+	for (size_t o = 0; o + 4 <= len - 4; o += 4) {
+		dst[o / 4] = (uint32_t)src[o] | ((uint32_t)src[o + 1] << 8) | ((uint32_t)src[o + 2] << 16) | ((uint32_t)src[o + 3] << 24);
+	}
+	printf("SWEET GPU: %s: %lu bytes at GPU VA 0x%08x (first words 0x%08x 0x%08x, header 0x%02x%02x%02x%02x)\n", file,
+	    (unsigned long)(len - 4), gpu_va, dst[0], dst[1], ((uint8_t *)fw)[3], ((uint8_t *)fw)[2], ((uint8_t *)fw)[1], ((uint8_t *)fw)[0]);
+	sweet_a630_fw_put(fw, len);
+	return true;
+}
