+	.d_open     = swd_open,
+	.d_close    = swd_close,
+	.d_strategy = swd_strategy,
+	.d_ioctl    = swd_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = swd_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw swd_cdevsw = {
+	.d_open       = swd_open,
+	.d_close      = swd_close,
+	.d_read       = swd_read,
+	.d_write      = swd_write,
+	.d_ioctl      = swd_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
