diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb5684a..b3887dae0 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1825,7 +1825,7 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
-#if defined(SWEET)
+#if defined(SWEET) && __ARM_16K_PG__
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
@@ -1849,6 +1849,49 @@ sweet_early_map_final(void)
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
+#elif defined(SWEET)
+/*
+ * 4K granule (patch 1022): the same idea with SWEET_EARLY_FB_BLOCKS 2MB blocks right above the
+ * low-globals block. With the small-memory layout (patch 1023) VM_MIN_KERNEL_ADDRESS has no tables
+ * yet, but LOW_GLOBAL_BASE_ADDRESS (0xfffffff000000000) shares its 1GB L1 entry with the kernel
+ * (0xfffffff007004000), and L2 slots 1-6 of that table lie between the low globals and the kernel.
+ * Every condition is checked instead of asserted: a failed placement only turns the early console
+ * back into a log (sweet_early_fb_mapped = 0) instead of an invisible panic.
+ */
+#define SWEET_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE)
+
+static void
+sweet_early_map_final(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	const unsigned int n = SWEET_EARLY_FB_BLOCKS;
+
+	if (!sweet_early_fb_mapped) {
+		return;
+	}
+	/* the 4K kernel root is a sub-page L1 (T1SZ_BOOT 26): index it like arm_vm_init does */
+	tt_entry_t l1 = cpu_tte[L1_TABLE_INDEX(va)];      /* xnu-8796: sub-page L1 root, as arm_vm_map() indexes it */
+	unsigned int idx = (unsigned int)((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+	if (va + n * ARM_TT_L2_SIZE > gVirtBase || idx + n > TTE_PGENTRIES ||
+	    (l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		sweet_early_fb_mapped = 0;
+		return;
+	}
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	for (unsigned int i = 0; i < n; i++) {
+		if (l2[idx + i] != ARM_TTE_EMPTY) {
+			sweet_early_fb_mapped = 0;
+			return;
+		}
+	}
+	for (unsigned int i = 0; i < n; i++) {
+		l2[idx + i] = ((uint64_t)SWEET_EARLY_FB_PA + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
 #endif
 
 void
@@ -2189,8 +2232,10 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	ml_enable_monitor();
 
 #if defined(SWEET)
-	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias (4K: only if placed). */
+	if (sweet_early_fb_mapped) {
+		sweet_early_relocate(SWEET_EARLY_FB_VA);
+	}
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
