+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (sweet_early_mirror_enabled()) {
+		va_list mirror;
+		va_start(mirror, fmt);
+		_doprnt_log(fmt, &mirror, sweet_kprintf_mirror_putc, 16);
+		va_end(mirror);
+	}
+#endif
 	if (!disable_serial_output && !disable_kprintf_output) {
