diff --git a/osfmk/arm64/sweet_lse_asm.h b/osfmk/arm64/sweet_lse_asm.h
new file mode 100644
index 0000000..1bfda0f
--- /dev/null
+++ b/osfmk/arm64/sweet_lse_asm.h
@@ -0,0 +1,98 @@
+/*
+ * SWEET: the memory primitives of the LSE emulation (osfmk/arm64/sweet_lseemu.h), as
+ * assembler macros shared by the kernel (machine_routines_asm.s, inside copyio recovery
+ * ranges) and the host test (tools/lseemu/lse_host.S), so both run the same loops.
+ * ARMv8.0 only: LDXR/STXR, LDXP/STXP, LDAR, DMB.
+ *
+ * Exclusives and faults: a page fault inside a loop (first touch, copy-on-write on the
+ * STXR) is resolved by the kernel abort handler, which returns to the faulting
+ * instruction. Exception return clears the local monitor (Arm ARM, AArch64.ExceptionReturn
+ * -> ClearExclusiveLocal), so an STXR after a fault fails and the loop restarts from the
+ * LDXR on the (possibly new) page. Every STXR failure restarts from the LDXR.
+ *
+ * Retry budget: memory that cannot hold an exclusive reservation (device or some
+ * non-cacheable mappings) makes STXR fail forever; after 2^20 failures the macros branch
+ * to \busy instead of spinning in the kernel.
+ */
+
+/* one size: \old = [x0]; if (\old == \exp) [x0] = \des; -> \done, or \busy. w6, x9 scratch */
+.macro SWEET_LSE_CAS_SZ ldx, stx, old, exp, des, done, busy
+	mov	x9, #(1 << 20)
+Lsweet_cas_ld_\@:
+	\ldx	\old, [x0]
+	cmp	\old, \exp
+	b.ne	Lsweet_cas_ne_\@
+	\stx	w6, \des, [x0]
+	cbz	w6, \done
+	subs	x9, x9, #1
+	b.ne	Lsweet_cas_ld_\@
+	b	\busy
+Lsweet_cas_ne_\@:
+	clrex
+	b	\done
+.endmacro
+
+/*
+ * x0 = user address (aligned), x1 = expected, x2 = desired (both zero-extended to the
+ * size), w4 = log2 size 0..3  ->  x5 = old value (zero-extended); then \done or \busy
+ * (the caller ends with DMB ISH on both paths). Clobbers w6, x9.
+ */
+.macro SWEET_LSE_CAS_BODY done, busy
+	dmb	ish
+	mov	x5, #0
+	cmp	w4, #2
+	b.eq	Lsweet_cas_w_\@
+	b.hi	Lsweet_cas_x_\@
+	cbnz	w4, Lsweet_cas_h_\@
+	SWEET_LSE_CAS_SZ ldxrb, stxrb, w5, w1, w2, \done, \busy
+Lsweet_cas_h_\@:
+	SWEET_LSE_CAS_SZ ldxrh, stxrh, w5, w1, w2, \done, \busy
+Lsweet_cas_w_\@:
+	SWEET_LSE_CAS_SZ ldxr, stxr, w5, w1, w2, \done, \busy
+Lsweet_cas_x_\@:
+	SWEET_LSE_CAS_SZ ldxr, stxr, x5, x1, x2, \done, \busy
+.endmacro
+
+/*
+ * x0 = user address (16-byte aligned), x1:x2 = expected lo:hi, x3:x4 = desired lo:hi
+ *   ->  x10:x11 = old lo:hi; then \done or \busy. Clobbers w12, x9.
+ * On a mismatch the old pair is written back: LDXP alone is not a single-copy atomic
+ * 128-bit read on ARMv8.0, a successful STXP of the same pair proves it was.
+ */
+.macro SWEET_LSE_CAS128_BODY done, busy
+	dmb	ish
+	mov	x9, #(1 << 20)
+Lsweet_cas128_ld_\@:
+	ldxp	x10, x11, [x0]
+	cmp	x10, x1
+	ccmp	x11, x2, #0, eq
+	b.ne	Lsweet_cas128_ne_\@
+	stxp	w12, x3, x4, [x0]
+	b	Lsweet_cas128_st_\@
+Lsweet_cas128_ne_\@:
+	stxp	w12, x10, x11, [x0]
+Lsweet_cas128_st_\@:
+	cbz	w12, \done
+	subs	x9, x9, #1
+	b.ne	Lsweet_cas128_ld_\@
+	b	\busy
+.endmacro
+
+/* x0 = user address (aligned), w4 = log2 size  ->  x5 = [x0] (load-acquire, zero-extended) */
+.macro SWEET_LSE_LOAD_BODY
+	cmp	w4, #2
+	b.eq	Lsweet_ld_w_\@
+	b.hi	Lsweet_ld_x_\@
+	cbnz	w4, Lsweet_ld_h_\@
+	ldarb	w5, [x0]
+	b	Lsweet_ld_done_\@
+Lsweet_ld_h_\@:
+	ldarh	w5, [x0]
+	b	Lsweet_ld_done_\@
+Lsweet_ld_w_\@:
+	ldar	w5, [x0]
+	b	Lsweet_ld_done_\@
+Lsweet_ld_x_\@:
+	ldar	x5, [x0]
+Lsweet_ld_done_\@:
+.endmacro
diff --git a/osfmk/arm64/sweet_lseemu.h b/osfmk/arm64/sweet_lseemu.h
new file mode 100644
index 0000000..7086dce
--- /dev/null
+++ b/osfmk/arm64/sweet_lseemu.h
@@ -0,0 +1,325 @@
+/*
+ * SWEET (Moto G6 Plus, SDM630 Kryo 260 Silver = Cortex-A53 class, ARMv8.0): trap-and-emulate
+ * for the ARMv8.1 LSE atomics and the ARMv8.3 RCpc load-acquire (LDAPR).
+ *
+ * The iOS userland is compiled for the A12 (ARMv8.3) and uses LSE inline everywhere
+ * (os_atomic, libc++ std::atomic, Swift, ObjC refcounts: ~426k sites in the iOS 18 dyld
+ * shared cache, docs/G6PLUS_HARDWARE.md). On ARMv8.0 those words are unallocated and
+ * raise an undefined instruction exception. sleh.c (handle_uncategorized) emulates them
+ * for 64-bit EL0 threads when ID_AA64ISAR0_EL1.Atomic says the CPU has no LSE:
+ *
+ *   LDADD/LDCLR/LDEOR/LDSET/LDSMAX/LDSMIN/LDUMAX/LDUMIN{A,L,AL}{B,H,,}  (and the ST* aliases)
+ *   SWP{A,L,AL}{B,H,,}
+ *   CAS{A,L,AL}{B,H,,}
+ *   CASP{A,L,AL} (W and X pairs)
+ *   LDAPR{B,H,}                                                         (ARMv8.3 RCpc)
+ *
+ * Atomicity: every memory update goes through one primitive, a compare-and-swap that
+ * the kernel implements with LDXR/STXR on the user address (machine_routines_asm.s,
+ * _sweet_lse_cas*; copyio recovery resolves page faults and retries). LD<op> and SWP
+ * are a CAS loop around it. All emulated atomics therefore use the exclusive monitor and
+ * are atomic against each other and against any native LL/SC code on other cores.
+ *
+ * Ordering: the primitives are bracketed by DMB ISH, i.e. every emulated atomic is at
+ * least as strong as the strongest (AL) form; LDAPR is done with LDAR (stronger than
+ * RCpc, same value). The A/L bits are decoded for the log and the tests only.
+ *
+ * Writes: like the hardware, LD<op>/SWP always write (also when the value does not
+ * change), so they fault on read-only memory. A CAS whose comparison fails writes
+ * nothing.
+ *
+ * Not handled (stay SIGILL): CASP with an odd Rs or Rt (unallocated), LD64B/ST64B*,
+ * LDAPUR* (v8.4), RCW*, the v8.9 LSE128 forms, SIMD/FP16/DotProd/RDM.
+ *
+ * Plain C with no kernel dependency so that the decoder and the executor can be
+ * unit-tested on the host against real LSE hardware (tools/lseemu/check.py).
+ */
+#ifndef _ARM64_SWEET_LSEEMU_H_
+#define _ARM64_SWEET_LSEEMU_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+enum sweet_lse_op {
+	SWEET_LSE_NONE = 0,
+	SWEET_LSE_LDOP,         /* Rt = old; mem = alu(old, Rs) */
+	SWEET_LSE_SWP,          /* Rt = old; mem = Rs */
+	SWEET_LSE_CAS,          /* if (mem == Rs) mem = Rt; Rs = old */
+	SWEET_LSE_CASP,         /* if (mem pair == Rs:Rs+1) mem pair = Rt:Rt+1; Rs:Rs+1 = old pair */
+	SWEET_LSE_LDAPR,        /* Rt = mem (acquire) */
+};
+
+/* LD<op> opc field (o3 = 0) */
+enum sweet_lse_alu {
+	SWEET_LSE_ADD = 0, SWEET_LSE_CLR, SWEET_LSE_EOR, SWEET_LSE_SET,
+	SWEET_LSE_SMAX, SWEET_LSE_SMIN, SWEET_LSE_UMAX, SWEET_LSE_UMIN,
+};
+
+/* instruction classes, for the log and the tests */
+enum sweet_lse_class {
+	SWEET_LSEC_LDOP = 0,
+	SWEET_LSEC_SWP,
+	SWEET_LSEC_CAS,
+	SWEET_LSEC_CASP,
+	SWEET_LSEC_LDAPR,
+	SWEET_LSEC_COUNT
+};
+
+struct sweet_lse_insn {
+	uint8_t op;             /* enum sweet_lse_op */
+	uint8_t cls;            /* enum sweet_lse_class */
+	uint8_t alu;            /* enum sweet_lse_alu (LDOP) */
+	uint8_t size;           /* log2 of the access in bytes: 0..3 (CASP: of one register, 2 or 3) */
+	uint8_t rs;             /* 31 = XZR */
+	uint8_t rt;             /* 31 = XZR */
+	uint8_t rn;             /* base, 31 = SP */
+	bool    acquire;
+	bool    release;
+};
+
+/*
+ * Decode one instruction word. Returns true and fills *out for the instructions listed
+ * above, false (op = SWEET_LSE_NONE) for everything else.
+ */
+static inline bool
+sweet_lse_decode(uint32_t w, struct sweet_lse_insn *out)
+{
+	const uint8_t rt = (uint8_t)(w & 31), rn = (uint8_t)((w >> 5) & 31), rs = (uint8_t)((w >> 16) & 31);
+
+	*out = (struct sweet_lse_insn){ .op = SWEET_LSE_NONE };
+
+	/*
+	 * Atomic memory operations: size 111 V=0 00 A R 1 Rs o3 opc 00 Rn Rt
+	 *   o3 = 0: LD<opc>;  o3 = 1, opc = 000: SWP;  o3 = 1, opc = 100, A = 1, R = 0, Rs = 11111: LDAPR
+	 */
+	if ((w & 0x3F200C00u) == 0x38200000u) {
+		const bool a = (w >> 23) & 1, r = (w >> 22) & 1, o3 = (w >> 15) & 1;
+		const uint8_t opc = (uint8_t)((w >> 12) & 7), size = (uint8_t)(w >> 30);
+		if (!o3) {
+			*out = (struct sweet_lse_insn){ .op = SWEET_LSE_LDOP, .cls = SWEET_LSEC_LDOP, .alu = opc,
+				                        .size = size, .rs = rs, .rt = rt, .rn = rn, .acquire = a, .release = r };
+			return true;
+		}
+		if (opc == 0) {
+			*out = (struct sweet_lse_insn){ .op = SWEET_LSE_SWP, .cls = SWEET_LSEC_SWP,
+				                        .size = size, .rs = rs, .rt = rt, .rn = rn, .acquire = a, .release = r };
+			return true;
+		}
+		if (opc == 4 && a && !r && rs == 31) {
+			*out = (struct sweet_lse_insn){ .op = SWEET_LSE_LDAPR, .cls = SWEET_LSEC_LDAPR,
+				                        .size = size, .rs = 31, .rt = rt, .rn = rn, .acquire = true };
+			return true;
+		}
+		return false;
+	}
+
+	/* CAS: size 001000 1 L 1 Rs o0 11111 Rn Rt */
+	if ((w & 0x3FA07C00u) == 0x08A07C00u) {
+		*out = (struct sweet_lse_insn){ .op = SWEET_LSE_CAS, .cls = SWEET_LSEC_CAS, .size = (uint8_t)(w >> 30),
+			                        .rs = rs, .rt = rt, .rn = rn,
+			                        .acquire = (w >> 22) & 1, .release = (w >> 15) & 1 };
+		return true;
+	}
+
+	/* CASP: 0 sz 001000 0 L 1 Rs o0 11111 Rn Rt; Rs and Rt must be even */
+	if ((w & 0xBFA07C00u) == 0x08207C00u) {
+		if ((rs & 1) || (rt & 1)) {
+			return false;
+		}
+		*out = (struct sweet_lse_insn){ .op = SWEET_LSE_CASP, .cls = SWEET_LSEC_CASP,
+			                        .size = (uint8_t)(2 + ((w >> 30) & 1)), .rs = rs, .rt = rt, .rn = rn,
+			                        .acquire = (w >> 22) & 1, .release = (w >> 15) & 1 };
+		return true;
+	}
+
+	return false;
+}
+
+/* the general-purpose register state the executor works on */
+struct sweet_lse_cpu {
+	uint64_t x[31];         /* x0 .. x30 */
+	uint64_t sp;
+	uint64_t pc;
+	uint32_t written;       /* set by sweet_lse_execute: bit r = x[r] written */
+};
+
+/*
+ * Memory callbacks; all return 0 or an errno (EFAULT: unmapped / not writable, EINVAL:
+ * misaligned or tagged). size is log2 of the access in bytes (0..3), addresses are
+ * naturally aligned by the caller's check, values are zero-extended.
+ *   load:  *val = [addr] with acquire semantics
+ *   cas:   atomically { *old = [addr]; if (*old == expected) [addr] = desired; }
+ *   cas128: the same on 16 bytes, lo at addr, hi at addr + 8
+ */
+struct sweet_lse_mem {
+	int (*load)(void *ctx, uint64_t addr, unsigned size, uint64_t *val);
+	int (*cas)(void *ctx, uint64_t addr, unsigned size, uint64_t expected, uint64_t desired, uint64_t *old);
+	int (*cas128)(void *ctx, uint64_t addr, uint64_t exp_lo, uint64_t exp_hi, uint64_t des_lo, uint64_t des_hi,
+	    uint64_t *old_lo, uint64_t *old_hi);
+	void *ctx;
+};
+
+enum sweet_lse_result {
+	SWEET_LSE_DONE = 0,     /* emulated, *cpu updated (PC included) */
+	SWEET_LSE_FAULT,        /* a memory callback failed: *err, *fault_addr; *cpu unchanged */
+	SWEET_LSE_UNHANDLED,    /* not an instruction handled here; *cpu unchanged */
+};
+
+static inline uint64_t
+sweet_lse_mask(unsigned size)
+{
+	return size >= 3 ? ~0ull : (1ull << (8u << size)) - 1;
+}
+
+static inline int64_t
+sweet_lse_sext(uint64_t v, unsigned size)
+{
+	const unsigned sh = 64u - (8u << size);
+	return (int64_t)(v << sh) >> sh;
+}
+
+/* the new memory value of LD<alu>, both operands already truncated to the access size */
+static inline uint64_t
+sweet_lse_alu_apply(unsigned alu, unsigned size, uint64_t old, uint64_t s)
+{
+	switch (alu) {
+	case SWEET_LSE_ADD:  return (old + s) & sweet_lse_mask(size);
+	case SWEET_LSE_CLR:  return old & ~s;
+	case SWEET_LSE_EOR:  return old ^ s;
+	case SWEET_LSE_SET:  return old | s;
+	case SWEET_LSE_SMAX: return sweet_lse_sext(old, size) >= sweet_lse_sext(s, size) ? old : s;
+	case SWEET_LSE_SMIN: return sweet_lse_sext(old, size) <= sweet_lse_sext(s, size) ? old : s;
+	case SWEET_LSE_UMAX: return old >= s ? old : s;
+	default:             return old <= s ? old : s;     /* UMIN */
+	}
+}
+
+static inline uint64_t
+sweet_lse_xzr(const struct sweet_lse_cpu *c, unsigned r)
+{
+	return r == 31 ? 0 : c->x[r];
+}
+
+/* write Wr/Xr: a W write (size < 3) zero-extends, the value is already truncated */
+static inline void
+sweet_lse_set_xzr(struct sweet_lse_cpu *c, unsigned r, uint64_t v)
+{
+	if (r != 31) {
+		c->x[r] = v;
+		c->written |= 1u << r;
+	}
+}
+
+/*
+ * Emulate instr (at cpu->pc). cpu->written tells the caller which registers to write
+ * back (the PC always changes). On SWEET_LSE_FAULT nothing was written to memory or
+ * registers (the CAS that failed did not store).
+ */
+static inline enum sweet_lse_result
+sweet_lse_execute(uint32_t instr, struct sweet_lse_cpu *cpu, const struct sweet_lse_mem *m,
+    int *err, uint64_t *fault_addr)
+{
+	struct sweet_lse_insn in;
+
+	if (!sweet_lse_decode(instr, &in)) {
+		return SWEET_LSE_UNHANDLED;
+	}
+
+	const uint64_t addr = in.rn == 31 ? cpu->sp : cpu->x[in.rn];
+	const uint64_t mask = sweet_lse_mask(in.size);
+	uint64_t old = 0;
+	int e = 0;
+
+	*fault_addr = addr;
+	cpu->written = 0;
+	switch (in.op) {
+	case SWEET_LSE_LDAPR:
+		e = m->load(m->ctx, addr, in.size, &old);
+		if (e) {
+			break;
+		}
+		sweet_lse_set_xzr(cpu, in.rt, old);
+		break;
+
+	case SWEET_LSE_LDOP:
+	case SWEET_LSE_SWP: {
+		const uint64_t s = sweet_lse_xzr(cpu, in.rs) & mask;
+		e = m->load(m->ctx, addr, in.size, &old);
+		for (;;) {
+			if (e) {
+				break;
+			}
+			const uint64_t new = in.op == SWEET_LSE_SWP ? s : sweet_lse_alu_apply(in.alu, in.size, old, s);
+			uint64_t seen = 0;
+			e = m->cas(m->ctx, addr, in.size, old, new, &seen);
+			if (!e && seen == old) {
+				break;
+			}
+			old = seen;
+		}
+		if (e) {
+			break;
+		}
+		sweet_lse_set_xzr(cpu, in.rt, old);
+		break;
+	}
+
+	case SWEET_LSE_CAS:
+		e = m->cas(m->ctx, addr, in.size, sweet_lse_xzr(cpu, in.rs) & mask, sweet_lse_xzr(cpu, in.rt) & mask, &old);
+		if (e) {
+			break;
+		}
+		sweet_lse_set_xzr(cpu, in.rs, old);
+		break;
+
+	case SWEET_LSE_CASP: {
+		const uint64_t s0 = sweet_lse_xzr(cpu, in.rs), s1 = sweet_lse_xzr(cpu, in.rs + 1u);
+		const uint64_t t0 = sweet_lse_xzr(cpu, in.rt), t1 = sweet_lse_xzr(cpu, in.rt + 1u);
+		if (in.size == 2) {
+			/* W pair = one 64-bit access, the first register at the lower address */
+			e = m->cas(m->ctx, addr, 3, (s0 & 0xFFFFFFFFull) | s1 << 32, (t0 & 0xFFFFFFFFull) | t1 << 32, &old);
+			if (e) {
+				break;
+			}
+			sweet_lse_set_xzr(cpu, in.rs, old & 0xFFFFFFFFull);
+			sweet_lse_set_xzr(cpu, in.rs + 1u, old >> 32);
+		} else {
+			uint64_t lo = 0, hi = 0;
+			e = m->cas128(m->ctx, addr, s0, s1, t0, t1, &lo, &hi);
+			if (e) {
+				break;
+			}
+			sweet_lse_set_xzr(cpu, in.rs, lo);
+			sweet_lse_set_xzr(cpu, in.rs + 1u, hi);
+		}
+		break;
+	}
+
+	default:
+		return SWEET_LSE_UNHANDLED;
+	}
+
+	if (e) {
+		*err = e;
+		cpu->written = 0;
+		return SWEET_LSE_FAULT;
+	}
+	cpu->pc += 4;
+	return SWEET_LSE_DONE;
+}
+
+/* bytes the access covers, for the alignment check */
+static inline unsigned
+sweet_lse_access_bytes(const struct sweet_lse_insn *in)
+{
+	return in->op == SWEET_LSE_CASP ? 2u << in->size : 1u << in->size;
+}
+
+static inline const char *
+sweet_lse_class_name(unsigned cls)
+{
+	static const char *const names[SWEET_LSEC_COUNT] = { "LD<op>", "SWP", "CAS", "CASP", "LDAPR" };
+	return cls < SWEET_LSEC_COUNT ? names[cls] : "?";
+}
+
+#endif /* _ARM64_SWEET_LSEEMU_H_ */
