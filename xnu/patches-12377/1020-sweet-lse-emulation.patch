+/*
+ * SWEET: emulate the ARMv8.1 LSE atomics and the ARMv8.3 LDAPR for 64-bit EL0 threads on a
+ * CPU without them (SDM630's Kryo 260 Silver is ARMv8.0; osfmk/arm64/sweet_lseemu.h). The
+ * memory side is copyio.c's sweet_lse_user_* (LDXR/STXR on the user address), so emulated
+ * atomics stay atomic across cores. Each trap costs about a microsecond; the log below is
+ * the profile that decides whether the shared cache must be rewritten instead.
+ */
+extern int sweet_lse_user_cas(user_addr_t user_addr, unsigned size, uint64_t expected, uint64_t desired,
+    uint64_t *old);
+extern int sweet_lse_user_cas128(user_addr_t user_addr, uint64_t exp_lo, uint64_t exp_hi, uint64_t des_lo,
+    uint64_t des_hi, uint64_t *old_lo, uint64_t *old_hi);
+extern int sweet_lse_user_load(user_addr_t user_addr, unsigned size, uint64_t *val);
+
+static int
+sweet_lse_k_load(void *ctx __unused, uint64_t addr, unsigned size, uint64_t *val)
+{
+	return sweet_lse_user_load((user_addr_t)VM_USER_STRIP_TBI(addr), size, val);
+}
+
+static int
+sweet_lse_k_cas(void *ctx __unused, uint64_t addr, unsigned size, uint64_t expected, uint64_t desired, uint64_t *old)
+{
+	return sweet_lse_user_cas((user_addr_t)VM_USER_STRIP_TBI(addr), size, expected, desired, old);
+}
+
+static int
+sweet_lse_k_cas128(void *ctx __unused, uint64_t addr, uint64_t exp_lo, uint64_t exp_hi, uint64_t des_lo,
+    uint64_t des_hi, uint64_t *old_lo, uint64_t *old_hi)
+{
+	return sweet_lse_user_cas128((user_addr_t)VM_USER_STRIP_TBI(addr), exp_lo, exp_hi, des_lo, des_hi, old_lo, old_hi);
+}
+
+/* does this CPU lack the instruction class? (only then is the trap ours to emulate) */
+static bool
+sweet_lse_cpu_lacks(unsigned cls)
+{
+	if (cls == SWEET_LSEC_LDAPR) {
+		/* ID_AA64ISAR1_EL1.LRCPC, bits [23:20] */
+		return ((__builtin_arm_rsr64("ID_AA64ISAR1_EL1") >> 20) & 0xF) == 0;
+	}
+	/* ID_AA64ISAR0_EL1.Atomic, bits [23:20]: 0b0010 = LSE */
+	return ((__builtin_arm_rsr64("ID_AA64ISAR0_EL1") >> 20) & 0xF) < 2;
+}
+
+static bool
+sweet_emulate_lse(arm_saved_state_t *state, uint32_t instr)
+{
+	static uint32_t sweet_lse_logged[SWEET_LSEC_COUNT];
+	static uint64_t sweet_lse_count[SWEET_LSEC_COUNT];     /* statistics: racy on purpose, no atomics */
+	static const struct sweet_lse_mem mem = {
+		.load = sweet_lse_k_load, .cas = sweet_lse_k_cas, .cas128 = sweet_lse_k_cas128, .ctx = NULL,
+	};
+	thread_t thread = current_thread();
+	struct sweet_lse_insn in;
+	struct sweet_lse_cpu cpu;
+	uint64_t fault_addr = 0;
+	int err = 0;
+
+	if (!sweet_lse_decode(instr, &in) || !sweet_lse_cpu_lacks(in.cls)) {
+		return false;
+	}
+
+	for (unsigned i = 0; i < 29; i++) {
+		cpu.x[i] = (uint64_t)get_saved_state_reg(state, i);
+	}
+	cpu.x[29] = (uint64_t)get_saved_state_fp(state);
+	cpu.x[30] = (uint64_t)get_saved_state_lr(state);
+	cpu.sp = (uint64_t)get_saved_state_sp(state);
+	cpu.pc = (uint64_t)get_saved_state_pc(state);
+	const uint64_t pc = cpu.pc;
+
+	thread->machine.recover_esr = 0;
+	thread->machine.recover_far = 0;
+	switch (sweet_lse_execute(instr, &cpu, &mem, &err, &fault_addr)) {
+	case SWEET_LSE_DONE:
+		break;
+	case SWEET_LSE_FAULT:
+		if (err == EINVAL) {
+			/* misaligned: the alignment fault the instruction raises (SIGBUS) */
+			mach_exception_data_type_t codes[2] = {EXC_ARM_DA_ALIGN, (mach_exception_data_type_t)fault_addr};
+			exception_triage(EXC_BAD_ACCESS, codes, 2);
+			__builtin_unreachable();
+		}
+		if (err == EAGAIN) {
+			printf("SWEET: LSE %s 0x%08x at pc=0x%llx: no exclusive reservation on 0x%llx\n",
+			    sweet_lse_class_name(in.cls), instr, (unsigned long long)pc, (unsigned long long)fault_addr);
+			mach_exception_data_type_t codes[2] = {KERN_PROTECTION_FAILURE, (mach_exception_data_type_t)fault_addr};
+			exception_triage(EXC_BAD_ACCESS, codes, 2);
+			__builtin_unreachable();
+		}
+		sweet_pac_fault(state, fault_addr);         /* EFAULT: SIGSEGV with the EL0 data-abort ESR */
+	default:
+		return false;
+	}
+
+	for (uint32_t m = cpu.written; m != 0; m &= m - 1) {
+		const unsigned r = (unsigned)__builtin_ctz(m);
+		if (r < 29) {
+			set_saved_state_reg(state, r, (register_t)cpu.x[r]);
+		} else if (r == 29) {
+			set_saved_state_fp(state, (register_t)cpu.x[29]);
+		} else {
+			set_user_saved_state_lr(state, (register_t)cpu.x[30]);
+		}
+	}
+	set_saved_state_pc(state, (register_t)cpu.pc);
+
+	/* profile, as for PAC: the first four of each class, then every power of two from 1024 on */
+	const uint64_t n = ++sweet_lse_count[in.cls];
+	if ((sweet_lse_logged[in.cls] < 4 && os_atomic_inc_orig(&sweet_lse_logged[in.cls], relaxed) < 4) ||
+	    (n >= 1024 && (n & (n - 1)) == 0)) {
+		task_t task = current_task();
+		void *bsd_info = get_bsdtask_info(task);
+		printf("SWEET: emulating %s 0x%08x at pc=0x%llx in %s[%d] (%llu so far, t=%llu)\n",
+		    sweet_lse_class_name(in.cls), instr, (unsigned long long)pc,
+		    bsd_info ? proc_name_address(bsd_info) : "?", task_pid(task), (unsigned long long)n,
+		    (unsigned long long)mach_absolute_time());
+	}
+	return true;
+}
+
 /*
  * Uncategorized exceptions are a catch-all for general execution errors.
  * ARM64_TODO: For now, we assume this is for undefined instruction exceptions.
@@ -1414,6 +1536,14 @@ handle_uncategorized(arm_saved_state_t *state)
 		return;
 	}
 
+	/*
+	 * An ARMv8.1 LSE atomic or ARMv8.3 LDAPR on a CPU without them (SDM630): emulate it
+	 * atomically. No boot-arg: the ID registers decide.
+	 */
+	if (PSR64_IS_USER64(get_saved_state_cpsr(state)) && sweet_emulate_lse(state, instr)) {
+		return;
+	}
+
