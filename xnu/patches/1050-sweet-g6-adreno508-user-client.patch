From a743e13bbb45fcbbefb70d9889dd01c63cf998ba Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Thu, 12 Nov 2026 17:44:27 -0300
Subject: [PATCH] sweet g6: Adreno 508 phase 3: sweet_gpu_* interface (GPU VA
 allocator, 4 KiB mappings, a5xx submit + fence) and the SweetAdreno630 user
 client (11215 0182 + iokit parts of 0184/0185), sweetgpu=4

---
 bsd/dev/sweet_a508.c              | 487 +++++++++++++++
 iokit/Kernel/arm/SweetAdreno.cpp  | 970 ++++++++++++++++++++++++++++++
 iokit/Kernel/arm/SweetAdrenoABI.h | 250 ++++++++
 iokit/conf/files.arm64            |   1 +
 4 files changed, 1708 insertions(+)
 create mode 100644 iokit/Kernel/arm/SweetAdreno.cpp
 create mode 100644 iokit/Kernel/arm/SweetAdrenoABI.h

diff --git a/bsd/dev/sweet_a508.c b/bsd/dev/sweet_a508.c
index 7e95c6cff..96a77cf20 100644
--- a/bsd/dev/sweet_a508.c
+++ b/bsd/dev/sweet_a508.c
@@ -649,6 +649,489 @@ a5_stage3(void)
 	return ok && got == 0x5085ca7c;
 }
 
+
+/* ------------------------------------------------------------------------------------------------ */
+/* Phase 3 (sweetgpu=4): the kept-up GPU as iokit/Kernel/arm/SweetAdreno.cpp expects it (the          */
+/* sweet_gpu_* interface of the Poco F1's driver, xnu-11215 patches 0181/0184/0185): GPU address      */
+/* allocator, 4 KiB mappings in context bank 0, submission with a fence the CP writes, parameters.    */
+/* Not thread safe: SweetAdreno.cpp holds its lock around every call. No interrupts, no recovery.     */
+/* ------------------------------------------------------------------------------------------------ */
+#define A5_VA_FENCE             (A5_VA + 0x12000u)      /* one word the CP writes with CACHE_FLUSH_TS */
+#define GVM_BASE                0x02000000ull
+#define GVM_END                 0xfff00000ull
+#define GVM_GUARD               0x1000ull
+#define GVM_MAXFREE             512u
+#define PTP_TABLES              512u                    /* 2 MiB of 4 KiB tables */
+#define A5_PA_MASK              ((1ull << 36) - 0x1000ull)
+#define A5_PTE_PAGE             (3ull | (1ull << 10) | (2ull << 8) | (1ull << 6) | (1ull << 11))
+#define A5_PTE_RDONLY           (1ull << 7)
+#define A5_RBBM_PERFCTR_CP_0_LO 0x3a0u
+#define CP_EVENT_WRITE          70u
+#define CP_INDIRECT_BUFFER_PFE  63u
+#define CACHE_FLUSH_TS          4u
+
+static struct {
+	bool ready, lost;
+	uint32_t seqno, submissions, hangs;
+	uint64_t bytes_mapped;
+	uint32_t mhz;
+} a5dev;
+static struct { uint64_t start, size; } gvm_free[GVM_MAXFREE];
+static unsigned gvm_nfree;
+static vm_offset_t ptp;
+static uint64_t ptp_pa;
+static unsigned ptp_used;
+
+void SweetAdrenoPublish(void);
+bool sweet_gpu_ready(void);
+bool sweet_gpu_param(uint32_t which, uint64_t *value);
+bool sweet_gpu_iova_alloc(uint64_t size, uint64_t *iova, uint64_t *taken);
+bool sweet_gpu_iova_reserve(uint64_t iova, uint64_t size);
+void sweet_gpu_iova_free(uint64_t iova, uint64_t size);
+bool sweet_gpu_vm_map(uint64_t iova, uint64_t pa, bool readonly);
+void sweet_gpu_vm_unmap(uint64_t iova, uint64_t size);
+void sweet_gpu_vm_flush(void);
+bool sweet_gpu_check_fault(void);
+void sweet_gpu_cache_sync(void *va, size_t len);
+uint32_t sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned count);
+bool sweet_gpu_fence_done(uint32_t fence);
+uint32_t sweet_gpu_fence_last(void);
+void sweet_gpu_mark_lost(void);
+void sweet_gpu_report(const char *why);
+void sweet_gpu_debug(uint32_t *w);
+
+static void
+a5_pte_wr(volatile uint64_t *slot, uint64_t v)
+{
+	*slot = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+gvm_init(void)
+{
+	vm_offset_t kva = 0;
+	vm_size_t size = (vm_size_t)PTP_TABLES * 0x1000;
+	if (kmem_alloc_contig(kernel_map, &kva, size, PAGE_MASK, (ppnum_t)atop_64(0xffffffffull), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	for (unsigned i = 1; pn && i < size / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(kva + i * PAGE_SIZE)) != pn + i) {
+			pn = 0;
+		}
+	}
+	if (!pn) {
+		return false;
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	for (unsigned i = 0; i < size / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	ptp = kva;
+	ptp_pa = ptoa_64(pn);
+	gvm_free[0].start = GVM_BASE;
+	gvm_free[0].size = GVM_END - GVM_BASE;
+	gvm_nfree = 1;
+	return true;
+}
+
+static uint64_t
+gvm_table_page(void)
+{
+	return ptp_used < PTP_TABLES ? ptp_pa + (uint64_t)(ptp_used++) * 0x1000 : 0;
+}
+
+/* CPU address of a table: the fixed ones of stage 3 live in a5mem, the rest in the pool. */
+static volatile uint64_t *
+gvm_table_va(uint64_t pa)
+{
+	if (pa & 0xfff) {
+		return NULL;
+	}
+	if (pa >= ptp_pa && pa - ptp_pa < (uint64_t)PTP_TABLES * 0x1000) {
+		return (volatile uint64_t *)(ptp + (pa - ptp_pa));
+	}
+	if (pa >= a5mem_pa && pa - a5mem_pa < A5_MAPPED) {
+		return (volatile uint64_t *)(a5mem + (pa - a5mem_pa));
+	}
+	return NULL;
+}
+
+static volatile uint64_t *
+gvm_slot(uint64_t iova, bool create)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)(a5mem + A5_L1), *tab;
+	uint64_t e, pa;
+	unsigned i1 = (unsigned)(iova >> 30) & 3, i2 = (unsigned)(iova >> 21) & 0x1ff, i3 = (unsigned)(iova >> 12) & 0x1ff;
+
+	if (iova < GVM_BASE || iova >= GVM_END) {
+		return NULL;
+	}
+	e = l1[i1];
+	if ((e & 3) != 3) {
+		if (!create || !(pa = gvm_table_page())) {
+			return NULL;
+		}
+		a5_pte_wr(&l1[i1], pa | 3);
+		e = pa | 3;
+	}
+	if (!(tab = gvm_table_va(e & A5_PA_MASK))) {
+		return NULL;
+	}
+	e = tab[i2];
+	if ((e & 3) != 3) {
+		if (!create || !(pa = gvm_table_page())) {
+			return NULL;
+		}
+		a5_pte_wr(&tab[i2], pa | 3);
+		e = pa | 3;
+	}
+	if (!(tab = gvm_table_va(e & A5_PA_MASK))) {
+		return NULL;
+	}
+	return tab + i3;
+}
+
+/* The context bank's own TLBIALL; never the global TLBIALLNSNH (see a5_smmu_setup). */
+static void
+gvm_tlb_flush(void)
+{
+	vm_offset_t b = a5smmu + SM_CB(A5_CB);
+	a5_wr(b, SM_CB_TLBIALL, 0);
+	a5_wr(b, SM_CB_TLBSYNC, 0);
+	for (int i = 0; i < 10000 && (a5_rd(b, SM_CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+}
+
+bool
+sweet_gpu_iova_alloc(uint64_t size, uint64_t *iova, uint64_t *taken)
+{
+	uint64_t need = size + GVM_GUARD;
+
+	if (!a5dev.ready || size == 0 || (size & 0xfff)) {
+		return false;
+	}
+	for (unsigned i = 0; i < gvm_nfree; i++) {
+		if (gvm_free[i].size >= need) {
+			*iova = gvm_free[i].start;
+			*taken = need;
+			gvm_free[i].start += need;
+			gvm_free[i].size -= need;
+			if (gvm_free[i].size == 0) {
+				memmove(&gvm_free[i], &gvm_free[i + 1], (gvm_nfree - i - 1) * sizeof(gvm_free[0]));
+				gvm_nfree--;
+			}
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+sweet_gpu_iova_reserve(uint64_t iova, uint64_t size)
+{
+	if (!a5dev.ready || size == 0 || (size & 0xfff) || (iova & 0xfff) || iova < GVM_BASE || iova + size > GVM_END) {
+		return false;
+	}
+	for (unsigned i = 0; i < gvm_nfree; i++) {
+		uint64_t st = gvm_free[i].start, e = st + gvm_free[i].size;
+		if (iova < st || iova + size > e) {
+			continue;
+		}
+		if (iova == st && iova + size == e) {
+			memmove(&gvm_free[i], &gvm_free[i + 1], (gvm_nfree - i - 1) * sizeof(gvm_free[0]));
+			gvm_nfree--;
+		} else if (iova == st) {
+			gvm_free[i].start += size;
+			gvm_free[i].size -= size;
+		} else if (iova + size == e) {
+			gvm_free[i].size -= size;
+		} else {
+			if (gvm_nfree == GVM_MAXFREE) {
+				return false;
+			}
+			memmove(&gvm_free[i + 1], &gvm_free[i], (gvm_nfree - i) * sizeof(gvm_free[0]));
+			gvm_nfree++;
+			gvm_free[i].size = iova - st;
+			gvm_free[i + 1].start = iova + size;
+			gvm_free[i + 1].size = e - (iova + size);
+		}
+		return true;
+	}
+	return false;
+}
+
+void
+sweet_gpu_iova_free(uint64_t iova, uint64_t size)
+{
+	unsigned i = 0;
+
+	while (i < gvm_nfree && gvm_free[i].start < iova) {
+		i++;
+	}
+	if (i > 0 && gvm_free[i - 1].start + gvm_free[i - 1].size == iova) {
+		gvm_free[i - 1].size += size;
+		if (i < gvm_nfree && gvm_free[i - 1].start + gvm_free[i - 1].size == gvm_free[i].start) {
+			gvm_free[i - 1].size += gvm_free[i].size;
+			memmove(&gvm_free[i], &gvm_free[i + 1], (gvm_nfree - i - 1) * sizeof(gvm_free[0]));
+			gvm_nfree--;
+		}
+		return;
+	}
+	if (i < gvm_nfree && iova + size == gvm_free[i].start) {
+		gvm_free[i].start = iova;
+		gvm_free[i].size += size;
+		return;
+	}
+	if (gvm_nfree == GVM_MAXFREE) {
+		printf("SWEET GPU: iova free list full; %#llx+%#llx lost\n", iova, size);
+		return;
+	}
+	memmove(&gvm_free[i + 1], &gvm_free[i], (gvm_nfree - i) * sizeof(gvm_free[0]));
+	gvm_nfree++;
+	gvm_free[i].start = iova;
+	gvm_free[i].size = size;
+}
+
+/* One 4 KiB page. */
+bool
+sweet_gpu_vm_map(uint64_t iova, uint64_t pa, bool readonly)
+{
+	volatile uint64_t *slot;
+
+	if (!a5dev.ready || (pa & ~A5_PA_MASK) || (iova & 0xfff) || !(slot = gvm_slot(iova, true))) {
+		return false;
+	}
+	a5_pte_wr(slot, pa | A5_PTE_PAGE | (readonly ? A5_PTE_RDONLY : 0));
+	a5dev.bytes_mapped += 0x1000;
+	return true;
+}
+
+void
+sweet_gpu_vm_unmap(uint64_t iova, uint64_t size)
+{
+	for (uint64_t d = 0; d < size; d += 0x1000) {
+		volatile uint64_t *slot = gvm_slot(iova + d, false);
+		if (slot && *slot) {
+			a5_pte_wr(slot, 0);
+			a5dev.bytes_mapped -= 0x1000;
+		}
+	}
+	gvm_tlb_flush();
+}
+
+void
+sweet_gpu_vm_flush(void)
+{
+	if (a5dev.ready) {
+		gvm_tlb_flush();
+	}
+}
+
+bool
+sweet_gpu_ready(void)
+{
+	return a5dev.ready && !a5dev.lost;
+}
+
+void
+sweet_gpu_cache_sync(void *va, size_t len)
+{
+	sweet_dma_sync_va(va, len);
+}
+
+/* msm MSM_PARAM_* */
+bool
+sweet_gpu_param(uint32_t which, uint64_t *value)
+{
+	if (!a5dev.ready) {
+		return false;
+	}
+	switch (which) {
+	case 1:  *value = 508; return true;                     /* GPU_ID */
+	case 2:  *value = A5_GMEM_BYTES; return true;           /* GMEM_SIZE */
+	case 3:  *value = 0x05000800; return true;              /* CHIP_ID */
+	case 4:  *value = (uint64_t)(a5dev.mhz ? a5dev.mhz : 19) * 1000000ull; return true;      /* MAX_FREQ: what it runs at */
+	case 5:  *value = (uint64_t)gr(A5_RBBM_PERFCTR_CP_0_LO) | ((uint64_t)gr(A5_RBBM_PERFCTR_CP_0_LO + 1) << 32);
+		return true;                                    /* TIMESTAMP: CP always-count, core clock ticks */
+	case 6:  *value = 0x100000; return true;                /* GMEM_BASE */
+	case 7:  *value = 1; return true;                       /* PRIORITIES */
+	case 8:  *value = 0; return true;                       /* PP_PGTABLE */
+	case 9:  *value = a5dev.hangs; return true;             /* FAULTS */
+	case 10: *value = 0; return true;                       /* SUSPENDS */
+	case 14: *value = GVM_BASE; return true;                /* VA_START */
+	case 15: *value = GVM_END - GVM_BASE; return true;      /* VA_SIZE */
+	default: return false;
+	}
+}
+
+uint32_t
+sweet_gpu_fence_last(void)
+{
+	return a5dev.seqno;
+}
+
+bool
+sweet_gpu_fence_done(uint32_t fence)
+{
+	uint32_t v = *(volatile uint32_t *)a5_cpu(A5_VA_FENCE);
+	return (int32_t)(v - fence) >= 0;
+}
+
+void
+sweet_gpu_report(const char *why)
+{
+	printf("SWEET GPU: %s: submitted %u, completed %u (scratch2 %u)\n", why, a5dev.seqno,
+	    *(volatile uint32_t *)a5_cpu(A5_VA_FENCE), gr(A5_CP_SCRATCH_REG(2)));
+	a5_report(why);
+}
+
+void
+sweet_gpu_mark_lost(void)
+{
+	if (!a5dev.lost) {
+		a5dev.lost = true;
+		a5dev.hangs++;
+		sweet_gpu_report("GPU LOST (no completion)");
+	}
+}
+
+bool
+sweet_gpu_check_fault(void)
+{
+	if (!a5dev.ready || !a5smmu) {
+		return false;
+	}
+	vm_offset_t b = a5smmu + SM_CB(A5_CB);
+	uint32_t fsr = a5_rd(b, SM_CB_FSR);
+	if (!(fsr & 0xc00001feu)) {
+		return false;
+	}
+	printf("SWEET GPU: SMMU CB%u FAULT: FSR %#x FAR %#x FSYNR0 %#x\n", A5_CB, fsr, a5_rd(b, SM_CB_FAR), a5_rd(b, SM_CB_FSYNR0));
+	a5_wr(b, SM_CB_FSR, fsr);
+	if (!a5dev.lost) {
+		a5dev.lost = true;
+		a5dev.hangs++;
+		sweet_gpu_report("GPU LOST (SMMU fault)");
+	}
+	return true;
+}
+
+/*
+ * One submission, as Linux's first a5xx_submit (v4.10, one ring, no preemption): each indirect buffer,
+ * the sequence number in CP_SCRATCH_REG(2), then CACHE_FLUSH_TS writing it to memory. Returns the
+ * sequence number, or 0 when the ring has no room for 2 s / the GPU is lost.
+ */
+uint32_t
+sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned count)
+{
+	unsigned need = 8 + 4 * count, room = 0;
+
+	if (!sweet_gpu_ready() || count == 0 || count > 128) {
+		return 0;
+	}
+	if (sweet_gpu_check_fault()) {
+		return 0;
+	}
+	for (unsigned i = 0; i < 20000; i++) {
+		uint32_t rptr = gr(A5_CP_RB_RPTR);
+		room = (rptr + A5_RB_BYTES / 4 - a5_wptr - 1) % (A5_RB_BYTES / 4);
+		if (room >= need) {
+			break;
+		}
+		delay(100);
+	}
+	if (room < need) {
+		sweet_gpu_mark_lost();
+		return 0;
+	}
+	if (++a5dev.seqno == 0) {
+		a5dev.seqno = 1;
+	}
+	for (unsigned i = 0; i < count; i++) {
+		a5_ring(A5_PKT7(CP_INDIRECT_BUFFER_PFE, 3));
+		a5_ring((uint32_t)ib_iova[i]);
+		a5_ring((uint32_t)(ib_iova[i] >> 32));
+		a5_ring(ib_dwords[i]);
+	}
+	a5_ring(A5_PKT4(A5_CP_SCRATCH_REG(2), 1));
+	a5_ring(a5dev.seqno);
+	a5_ring(A5_PKT7(CP_EVENT_WRITE, 4));
+	a5_ring(CACHE_FLUSH_TS | (1u << 31));
+	a5_ring(A5_VA_FENCE);
+	a5_ring(0);
+	a5_ring(a5dev.seqno);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gw(A5_CP_RB_WPTR, a5_wptr);
+	a5dev.submissions++;
+	return a5dev.seqno;
+}
+
+void
+sweet_gpu_debug(uint32_t *w)
+{
+	bzero(w, 40 * sizeof(uint32_t));
+	if (!a5.cc || !a5.gpu) {
+		return;
+	}
+	w[0] = 1u | (a5dev.lost ? 2u : 0u) | (a5dev.ready ? 4u : 0u);
+	w[5] = a5_rd(a5.cc, CC_GX_GDSCR);
+	w[6] = a5_rd(a5.cc, CC_CX_GDSCR);
+	w[7] = a5_rd(a5.cc, CC_GFX3D_CBCR);
+	w[15] = a5dev.seqno;
+	w[16] = a5_wptr;
+	w[17] = *(volatile uint32_t *)a5_cpu(A5_VA_FENCE);
+	w[19] = gr(A5_RBBM_STATUS);
+	w[20] = gr(A5_CP_RB_RPTR);
+	w[21] = gr(A5_RBBM_INT_0_STATUS);
+	w[22] = gr(A5_CP_HW_FAULT);
+	w[23] = a5smmu ? a5_rd(a5smmu, SM_CB(A5_CB) + SM_CB_FSR) : 0;
+	w[24] = a5dev.submissions;
+	w[25] = a5dev.hangs;
+	w[26] = (uint32_t)(a5dev.bytes_mapped >> 12);
+	w[27] = ptp_used;
+}
+
+/* Self-test of the submission path (a NOP-only indirect buffer in the fixed mapping), then publish. */
+static bool
+a5_stage4(uint32_t mhz)
+{
+	a5dev.mhz = mhz;
+	if (!gvm_init()) {
+		printf("SWEET GPU: no memory for the GPU page-table pool; interface not published\n");
+		return false;
+	}
+	*(volatile uint32_t *)a5_cpu(A5_VA_FENCE) = 0;
+	a5dev.ready = true;
+	/* indirect buffer at the end of the fixed mapping: two NOPs */
+	uint32_t ib_va = A5_VA + 0x13000u;
+	volatile uint32_t *ib = a5_cpu(ib_va);
+	ib[0] = A5_PKT7(CP_NOP, 1);
+	ib[1] = 0;
+	ib[2] = A5_PKT7(CP_NOP, 1);
+	ib[3] = 0;
+	uint64_t iova = ib_va, t0 = mach_absolute_time(), ns = 0;
+	uint32_t dwords = 4;
+	uint32_t f = sweet_gpu_submit(&iova, &dwords, 1);
+	for (int i = 0; f && i < 200000 && !sweet_gpu_fence_done(f); i++) {
+		delay(10);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (!f || !sweet_gpu_fence_done(f)) {
+		sweet_gpu_mark_lost();
+		a5dev.ready = false;
+		return false;
+	}
+	printf("SWEET GPU: self-test submission %u completed in %llu us (fence word %u, scratch2 %u); page-table pool at 0x%llx, GPU VA 0x%llx-0x%llx\n",
+	    f, ns / 1000, *(volatile uint32_t *)a5_cpu(A5_VA_FENCE), gr(A5_CP_SCRATCH_REG(2)), ptp_pa, GVM_BASE, GVM_END);
+	SweetAdrenoPublish();
+	return true;
+}
+
 static void
 a508_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -778,6 +1261,10 @@ a508_thread(void *arg __unused, wait_result_t wr __unused)
 		if (zap && stage >= 3) {
 			bool cp = a5_stage3();
 			printf("SWEET GPU: %s\n", cp ? "THE ADRENO 508 COMMAND PROCESSOR RUNS" : "stage 3 did not finish");
+			if (cp && stage >= 4) {
+				bool up = a5_stage4(mhz);
+				printf("SWEET GPU: %s\n", up ? "SweetAdreno630 service published (Adreno 508 behind it)" : "stage 4 did not finish");
+			}
 		}
 	}
