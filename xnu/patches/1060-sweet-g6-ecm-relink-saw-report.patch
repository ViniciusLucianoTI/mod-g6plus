From e3fc7f430c869335179524371b4103d0fbf0673a Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Wed, 18 Nov 2026 00:40:16 -0300
Subject: [PATCH] sweet: ECM watchdog re-announces the link; CPU clock report
 also reads the cluster SAW4 voltage status

---
 bsd/dev/sweet_a508.c | 17 +++++++++++++++++
 bsd/dev/sweet_usb.c  | 13 +++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/bsd/dev/sweet_a508.c b/bsd/dev/sweet_a508.c
index 99313dfb3..a1bb95986 100644
--- a/bsd/dev/sweet_a508.c
+++ b/bsd/dev/sweet_a508.c
@@ -1521,6 +1521,23 @@ a5_gov_thread(void *arg __unused, wait_result_t wr __unused)
 				    a5_rd(pll, 0), l, l * 192 / 10, (l * 192) % 10, a5_rd(pll, 8), a5_rd(pll, 0xc), a5_rd(pll, 0x10), a5_rd(pll, 0x1c), a5_rd(rcg, 0x50), a5_rd(rcg, 0x54));
 			}
 		}
+		/*
+		 * The cluster rails are driven through the SAW4 of each cluster's L2 (stock DT: "APCLUS0_L2_SAW4_PMIC_STS" =
+		 * 0x17912c18, units of mV per qcom,cpr-saw-use-unit-mV; the other cluster's block is 0x17812000). Read only:
+		 * what voltage the bootloader left, which decides how far the PLLs may be raised without touching the rail.
+		 * This phone's open-loop voltages per frequency are in backup/evert/cpuclk-* (CPR debugfs under Android).
+		 */
+		static const struct { const char *name; vm_offset_t pa; } saw[2] = { { "pwrcl L2 SAW4", 0x17912000 }, { "perfcl L2 SAW4", 0x17812000 } };
+		for (int i = 0; i < 2; i++) {
+			vm_offset_t v = ml_io_map(saw[i].pa, 0x1000);
+			if (v) {
+				printf("SWEET CPUCLK: %s +0xc00:", saw[i].name);
+				for (uint32_t o = 0xc00; o < 0xc40; o += 4) {
+					printf(" %08x", a5_rd(v, o));
+				}
+				printf("\n");
+			}
+		}
 		vm_offset_t osm = ml_io_map(0x179c0000, 0x4000);
 		if (osm) {
 			for (uint32_t base = 0; base < 0x4000; base += 0x2000) {
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index f6072dc00..63bf854c6 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1331,6 +1331,19 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 							printf("SWEET USB: ue0 transmit stuck for %u ms (frame %llu, trb %08x/%08x, queue %u): transfer ended, frame dropped (#%u)\n",
 							    wd_ms, wd_frames, w2, w3, ud.txq_count, wd_fired);
 						}
+						/*
+						 * Seen with the watchdog in place (2026-11-18): it fired twenty times in a row, every frame
+						 * stuck, and on the Mac the interface was "inactive" with no address: the host had dropped
+						 * the link and no longer reads the IN endpoint. Tell it again that the network is connected
+						 * (the notification it brought the link up on at configuration time).
+						 */
+						if (ud.configured) {
+							if (ud.xfer_active[EP_INT]) {
+								ud_epcmd(EP_INT, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[EP_INT] << 16), 0, 0, 0);
+								ud.xfer_active[EP_INT] = false;
+							}
+							ud_notify_connected();
+						}
 						ud_tx_kick_locked();
 					}
 					lck_mtx_unlock(ud.lock);
-- 
2.56.0

