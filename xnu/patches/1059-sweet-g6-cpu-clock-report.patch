From 8f3b6cddeb4979606391f7b7da7549bbb47404b6 Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Wed, 18 Nov 2026 00:23:32 -0300
Subject: [PATCH] sweet: sweetcpuclkdump=1, read-only report of the SDM630 CPU
 cluster clocks

---
 bsd/dev/sweet_a508.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/bsd/dev/sweet_a508.c b/bsd/dev/sweet_a508.c
index fc1ad4513..99313dfb3 100644
--- a/bsd/dev/sweet_a508.c
+++ b/bsd/dev/sweet_a508.c
@@ -1503,6 +1503,35 @@ a5_gov_thread(void *arg __unused, wait_result_t wr __unused)
 	(void)PE_parse_boot_argn("sweetgpuhot", &hot, sizeof(hot));
 	a5clk.acc = ml_io_map(0x01fcf000, 0x1000);
 	a5clk.tsens = ml_io_map(0x010ae000, 0x1000);
+	/*
+	 * sweetcpuclkdump=1: where the CPU clocks stand (read only). Nothing in this kernel manages them on the SDM630,
+	 * so they are as ABL left them. Stock DT qcom,clk-cpu-osm-sdm630: cluster PLLs at 0x17916000 (cpu4-7, "pwrcl")
+	 * and 0x17816000 (cpu0-3, "perfcl") with the L value at +4 (frequency = L * 19.2 MHz when the cluster runs from
+	 * its PLL), their RCGs at 0x17911050 / 0x17811050, the OSM at 0x179c0000.
+	 */
+	uint32_t cpudump = 0;
+	(void)PE_parse_boot_argn("sweetcpuclkdump", &cpudump, sizeof(cpudump));
+	if (cpudump) {
+		static const struct { const char *name; vm_offset_t pll, rcg; } cl[2] = { { "pwrcl (cpu4-7)", 0x17916000, 0x17911000 }, { "perfcl (cpu0-3)", 0x17816000, 0x17811000 } };
+		for (int i = 0; i < 2; i++) {
+			vm_offset_t pll = ml_io_map(cl[i].pll, 0x1000), rcg = ml_io_map(cl[i].rcg, 0x1000);
+			if (pll && rcg) {
+				uint32_t l = a5_rd(pll, 4);
+				printf("SWEET CPUCLK: %s PLL MODE 0x%08x L %u (= %u.%u MHz) +0x08 0x%08x USER_CTL 0x%08x +0x10 0x%08x STATUS? 0x%08x; RCG CMD 0x%08x CFG 0x%08x\n", cl[i].name,
+				    a5_rd(pll, 0), l, l * 192 / 10, (l * 192) % 10, a5_rd(pll, 8), a5_rd(pll, 0xc), a5_rd(pll, 0x10), a5_rd(pll, 0x1c), a5_rd(rcg, 0x50), a5_rd(rcg, 0x54));
+			}
+		}
+		vm_offset_t osm = ml_io_map(0x179c0000, 0x4000);
+		if (osm) {
+			for (uint32_t base = 0; base < 0x4000; base += 0x2000) {
+				printf("SWEET CPUCLK: OSM +0x%04x:", base);
+				for (uint32_t o = 0; o < 0x40; o += 4) {
+					printf(" %08x", a5_rd(osm, base + o));
+				}
+				printf("\n");
+			}
+		}
+	}
 	a5_pll_dump("before any level change");
 	if (a5clk.tsens) {
 		printf("SWEET GPU: TSENS status words:");
-- 
2.56.0

