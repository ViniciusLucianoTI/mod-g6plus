From 935d95fba5be9e9cef9732f5630540c7e5437152 Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Fri, 13 Nov 2026 00:36:06 -0300
Subject: [PATCH] sweet g6: SWDB drops a stale header-only reply and waits
 again (the dead-HELLO boots)

---
 bsd/dev/sweet_usb.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 0fd2688d9..8543536ee 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -379,6 +379,7 @@ static struct {
 	bool        ready;          /* block device registered */
 	bool        writable;
 	uint32_t    hello_failures;
+	uint32_t    stale_replies;
 	bool        input;          /* the host has key/touch events for us */
 	uint32_t    input_events;
 	uint64_t    nblocks;
@@ -1720,6 +1721,33 @@ swd_request_raw(uint32_t type, uint32_t seq, uint64_t lba, uint32_t nblk, uint32
 		error = swd_wait(&swd.rx_done, timeout_ms);
 	}
 	const volatile uint32_t *r = (const volatile uint32_t *)(ud.dma + UD_DRXB);
+	/*
+	 * A stale reply first. Captured on the Moto G6 Plus (2026-11-13, the "dead HELLO" boots, through the
+	 * in-band report of patch 1047): HELLO 1 times out in tx as on every boot, but in those boots its packet
+	 * still reached the host, whose reply then sits in front of every later one: `HELLO 2 failed in reply:
+	 * reply 42445753 00000081 00000002` while seq 3 was expected, then 3 for 5, 5 for 6, ... for the whole
+	 * boot. A well-formed header-only reply with an OLDER sequence number is dropped and the wait repeated.
+	 */
+	for (int stale = 0; !error && stale < 8; stale++) {
+		ud_sync(UD_DRXB, SWD_HDR);
+		uint32_t rt = r[1] & 0x7fu;
+		if (r[0] != SWD_MAGIC || !(r[1] & 0x80u) || (int32_t)(seq - r[2]) <= 0 || (int32_t)(seq - r[2]) > 64 ||
+		    (rt != SWD_HELLO && rt != SWD_WRITE && rt != SWD_FLUSH && rt != SWD_INPUT)) {
+			break;
+		}
+		swd.stale_replies++;
+		swd.rx_done = false;
+		lck_mtx_lock(ud.lock);
+		if (!ud.configured) {
+			lck_mtx_unlock(ud.lock);
+			error = ENXIO;
+			break;
+		}
+		ud_start_trb(EP_DRX, UD_TRB_DRX, UD_DRXB, SWD_HDR + data_in, TRBCTL_NORMAL);
+		lck_mtx_unlock(ud.lock);
+		phase = "rx";
+		error = swd_wait(&swd.rx_done, timeout_ms);
+	}
 	if (!error) {
 		ud_sync(UD_DRXB, SWD_HDR + data_in);
 		if (r[0] != SWD_MAGIC || r[1] != (type | 0x80u) || r[2] != seq) {
-- 
