 IOReturn
 SweetAdrenoUserClient::gemInfo(struct sweet_msm_gem_info *r)
 {
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	struct sweet_gem *g = gem(r->handle);
 	IOReturn ret = kIOReturnBadArgument;
 
@@ -484,14 +549,14 @@ SweetAdrenoUserClient::gemInfo(struct sweet_msm_gem_info *r)
 			break;
 		}
 	}
-	IOLockUnlock(gAdrenoLock);
+	sweet_gpu_unlock();
 	return ret;
 }
 
 IOReturn
 SweetAdrenoUserClient::cpuPrep(struct sweet_msm_gem_cpu_prep *r)
 {
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	struct sweet_gem *g = gem(r->handle);
 	IOReturn ret = kIOReturnBadArgument;
 
@@ -510,7 +575,7 @@ SweetAdrenoUserClient::cpuPrep(struct sweet_msm_gem_cpu_prep *r)
 			ret = kIOReturnBusy;
 		}
 	}
-	IOLockUnlock(gAdrenoLock);
+	sweet_gpu_unlock();
 	return ret;
 }
 
@@ -576,7 +641,7 @@ SweetAdrenoUserClient::submit(struct sweet_msm_gem_submit *r)
 		}
 	}
 
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	if (!sweet_gpu_ready()) {
 		ret = kIOReturnNotReady;
 		goto unlock;
@@ -646,7 +711,7 @@ SweetAdrenoUserClient::submit(struct sweet_msm_gem_submit *r)
 		ret = kIOReturnSuccess;
 	}
 unlock:
-	IOLockUnlock(gAdrenoLock);
+	sweet_gpu_unlock();
 out:
 	if (bos != NULL) {
 		IOFreeData(bos, bosSize);
@@ -666,7 +731,7 @@ out:
 IOReturn
 SweetAdrenoUserClient::waitFenceCall(struct sweet_msm_wait_fence *r)
 {
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	IOReturn ret;
 
 	if (r->queueid >= QUEUE_IDS || (r->queueid != 0 && !(fQueues & (1ull << r->queueid)))) {
@@ -676,9 +741,11 @@ SweetAdrenoUserClient::waitFenceCall(struct sweet_msm_wait_fence *r)
 	} else {
 		uint64_t ns = (r->timeout.tv_sec < 0 || r->timeout.tv_nsec < 0) ? 0 :
 		    (uint64_t)r->timeout.tv_sec * NSEC_PER_SEC + (uint64_t)r->timeout.tv_nsec;
-		ret = waitFence(r->fence, ns) ? kIOReturnSuccess : (sweet_gpu_ready() ? kIOReturnTimeout : kIOReturnIOError);
+		uint32_t epoch = sweet_gpu_epoch();
+		ret = waitFence(r->fence, ns) && epoch == sweet_gpu_epoch() ? kIOReturnSuccess :
+		    ((sweet_gpu_ready() && epoch == sweet_gpu_epoch()) ? kIOReturnTimeout : kIOReturnIOError);
 	}
-	IOLockUnlock(gAdrenoLock);
+	sweet_gpu_unlock();
 	return ret;
 }
 
@@ -691,13 +758,47 @@ SweetAdrenoUserClient::surfaceBo(struct sweet_gpu_surface_bo *r)
 	if (s == NULL) {
 		return kIOReturnNotFound;
 	}
-	if (s->memory == NULL || s->wrapped) {
+	if (s->memory == NULL) {
 		s->release();
-		return kIOReturnUnsupported;       /* wrapped client memory is pageable: never entered into the GPU */
+		return kIOReturnUnsupported;
 	}
+	/*
+	 * Client-memory (wrapped) surfaces: the memory is another task's, wired by IOMemoryDescriptor::prepare() for as long
+	 * as the SweetSurface lives (sweet_surface_use_task_memory); this BO holds a reference to the surface, so the pages
+	 * stay wired until GEM_CLOSE / connection close, whichever the owner does. The pixels start `wrapDelta` bytes into the
+	 * first page. Such pages are entered READ-ONLY into the GPU: if the owner dies its address space is torn down and
+	 * wired pages are freed, and a GPU that could still write them would corrupt whatever the page becomes. The CPU maps
+	 * them cacheable: BO_SYNC (or SBO_IN_SYNC) after CPU writes.
+	 */
+	const bool wrapped = s->wrapped;
 	uint64_t size = round_page_64(s->memory->getLength());
 	r->size = size;
-	r->offset = s->offset;
+	r->offset = s->offset + (wrapped ? s->wrapDelta : 0);
+	r->tiling = 0;
+	r->ubwc = 0;
+	{
+		uint32_t f = 0;
+		if (wrapped) {
+			f |= SWEET_GPU_SBO_READONLY | SWEET_GPU_SBO_CPU_CACHEABLE | SWEET_GPU_SBO_WRAPPED;
+		} else if (s->pooled && sweet_lowpool_cacheable()) {
+			f |= SWEET_GPU_SBO_CPU_CACHEABLE;
+		}
+		r->flags = (r->flags & SWEET_GPU_SBO_IN_SYNC) | f;      /* keep the input bit for below */
+	}
+	bzero(r->plane, sizeof(r->plane));
+	if (s->planeCount == 0) {
+		r->plane[0].offset = r->offset;
+		r->plane[0].stride = s->bytesPerRow;
+		r->plane[0].width = s->width;
+		r->plane[0].height = s->height;
+	} else {
+		for (uint32_t i = 0; i < s->planeCount && i < 3; i++) {
+			r->plane[i].offset = s->planes[i].offset + (wrapped ? s->wrapDelta : 0);
+			r->plane[i].stride = s->planes[i].bytesPerRow;
+			r->plane[i].width = s->planes[i].width;
+			r->plane[i].height = s->planes[i].height;
+		}
+	}
 	r->bytes_per_row = s->bytesPerRow;
 	r->width = s->width;
 	r->height = s->height;
@@ -713,11 +814,26 @@ SweetAdrenoUserClient::surfaceBo(struct sweet_gpu_surface_bo *r)
 		s->release();
 		return kIOReturnBadArgument;
 	}
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	ret = kIOReturnNoResources;
 	if (!sweet_gpu_ready()) {
 		ret = kIOReturnNotReady;
 	} else {
+		/* Idempotent: the same surface in the same connection is the same BO (one mapping per surface, not per frame). */
+		for (uint32_t i = 0; i < GEM_MAX; i++) {
+			if (fGems[i].md != NULL && fGems[i].surface == s) {
+				r->handle = i + 1;
+				r->iova = fGems[i].iova;
+				r->flags |= SWEET_GPU_SBO_EXISTING;
+				if ((r->flags & SWEET_GPU_SBO_IN_SYNC) && fGems[i].kva != NULL) {
+					sweet_gpu_cache_sync(fGems[i].kva, (size_t)fGems[i].size);
+				}
+				r->flags &= ~(uint32_t)SWEET_GPU_SBO_IN_SYNC;
+				sweet_gpu_unlock();
+				s->release();
+				return kIOReturnSuccess;
+			}
+		}
 		for (uint32_t n = 0; n < GEM_MAX; n++) {
 			uint32_t i = (fNextGem + n) % GEM_MAX;
 			if (fGems[i].md == NULL) {
@@ -726,22 +842,27 @@ SweetAdrenoUserClient::surfaceBo(struct sweet_gpu_surface_bo *r)
 				s->memory->retain();
 				g->md = s->memory;
 				g->surface = s;         /* our reference moves into the slot on success */
-				g->kva = (uint8_t *)s->kernelAddress();
+				uintptr_t ka = s->kernelAddress();      /* of the first pixel (+wrapDelta): the BO starts at the page */
+				g->kva = ka != 0 ? (uint8_t *)(ka - (wrapped ? s->wrapDelta : 0)) : NULL;
 				g->size = size;
-				ret = mapGem(g, 0, &r->handle, 0);
+				ret = mapGem(g, wrapped ? SWEET_MSM_BO_GPU_READONLY : 0, &r->handle, 0);
 				if (ret != kIOReturnSuccess) {
 					g->md->release();
 					bzero(g, sizeof(*g));
 				} else {
 					fNextGem = i + 1;
 					r->iova = g->iova;
+					if ((r->flags & SWEET_GPU_SBO_IN_SYNC) && g->kva != NULL) {
+						sweet_gpu_cache_sync(g->kva, (size_t)g->size);
+					}
+					r->flags &= ~(uint32_t)SWEET_GPU_SBO_IN_SYNC;
 					s = NULL;
 				}
 				break;
 			}
 		}
 	}
-	IOLockUnlock(gAdrenoLock);
+	sweet_gpu_unlock();
 	if (s != NULL) {
 		s->release();
 	}
@@ -751,7 +872,7 @@ SweetAdrenoUserClient::surfaceBo(struct sweet_gpu_surface_bo *r)
 IOReturn
 SweetAdrenoUserClient::boSync(struct sweet_gpu_bo_sync *r)
 {
-	IOLockLock(gAdrenoLock);
+	sweet_gpu_lock();
 	struct sweet_gem *g = gem(r->handle);
