From 49143c5e0094ecba76571b563f40b2242e93e7eb Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Wed, 18 Nov 2026 00:54:42 -0300
Subject: [PATCH] sweet: CPU cluster clocks on the SDM630 (retune the cluster
 PLLs within the boot rail voltage; sweetcpubig/sweetcpulittle, 'CPUF')

---
 bsd/dev/sweet_a508.c | 120 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 120 insertions(+)

diff --git a/bsd/dev/sweet_a508.c b/bsd/dev/sweet_a508.c
index 0ee8c2909..5a2a3eb78 100644
--- a/bsd/dev/sweet_a508.c
+++ b/bsd/dev/sweet_a508.c
@@ -1174,6 +1174,7 @@ sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned co
 }
 
 static void sweet_a508_request_mhz(uint32_t mhz);
+static volatile uint32_t a5cpu_request[2];
 static void sweet_a508_clock_state(uint32_t *mhz, uint32_t *temp, uint32_t *changes);
 
 void
@@ -1202,6 +1203,10 @@ sweet_gpu_debug(uint32_t *w)
 	}
 	/* w[39] = 'FREQ': w[36] = MHz to pin the core clock at, 1 = governor, 0 = only report. Answer: w[36] = MHz now (0 = the
 	 * bring-up clock), w[37] = hottest TSENS sensor in tenths of a degree, w[38] = level changes so far. Not behind sweetgpupoke. */
+	/* w[39] = 'CPUF': w[36] = cluster (0 little, 1 big), w[37] = MHz (1 = back to the bootloader's clock). Applied by the governor thread. */
+	if (op == 0x43505546u && reg < 2) {
+		a5cpu_request[reg] = val;
+	}
 	bool freq = op == 0x46524551u;
 	if (freq && reg) {
 		sweet_a508_request_mhz(reg);
@@ -1490,6 +1495,113 @@ a5_level_for(uint32_t mhz, bool at_most)
 	return r;
 }
 
+/*
+ * CPU cluster clocks (SDM630, Moto G6 Plus). Nothing else in this kernel manages them: the bootloader leaves
+ * cpu0-3 ("perfcl", PLL at 0x17816000, RCG at 0x17811050) on their PLL at L 87 = 1670.4 MHz and cpu4-7 ("pwrcl",
+ * 0x17916000 / 0x17911050) on the GPLL0 source (RCG CFG 0x401), i.e. a few hundred MHz, with their own PLL
+ * running unused at L 32; the OSM block that the stock kernel hands them to is off (read 2026-11-18).
+ * From the stock kernel's OSM driver (drivers/clk/msm/clock-osm.c, the msm8998 variant, same PLL): registers
+ * MODE +0x0, L +0x4, USER_CTL +0xc, CONFIG_CTL +0x10; bring-up = MODE 0, write L, MODE 2, 10 us, MODE 6, 50-75 us,
+ * MODE 7; RCG CFG source field 0x400 = GPLL0, 0x500 = cluster PLL (early output), CMD 0x3 = update, reads back 0x2
+ * when done. The PLL frequency is L * 19.2 MHz.
+ * So a cluster is retuned by parking it on GPLL0 (the little cluster already is), restarting its PLL at the new L
+ * and switching the RCG back. The rails are NOT touched here: PM660 S1/S2/S3 read 868/872/872 mV at boot, which by
+ * this phone's own CPR open-loop table (backup/evert/cpuclk-*, NOTES.md) covers 2016 MHz on the big cluster (832 mV)
+ * and 1536 MHz on the little one (832 mV); those are the limits enforced below. Other units have other fuses.
+ * Requests: boot-args sweetcpubig=MHZ / sweetcpulittle=MHZ, or the debug selector ('CPUF', gpureg cpu big|little MHZ).
+ * If the hottest sensor passes 90 C both clusters go back to what the bootloader had.
+ */
+static const struct { const char *name; vm_offset_t pll_pa, rcg_pa; uint32_t boot_l, max_l; } a5cpu_def[2] = {
+	{ "little (cpu4-7)", 0x17916000, 0x17911000, 0, 80 },          /* boot: on GPLL0; up to L 80 = 1536 MHz */
+	{ "big (cpu0-3)", 0x17816000, 0x17811000, 87, 105 },           /* boot: L 87; up to L 105 = 2016 MHz */
+};
+static struct { vm_offset_t pll, rcg; uint32_t l; bool raised; } a5cpu[2];
+static volatile uint32_t a5cpu_request[2];      /* MHz asked for per cluster, 0 = none pending, 1 = back to boot */
+
+static bool
+a5cpu_rcg(int c, uint32_t cfg)
+{
+	a5_wr(a5cpu[c].rcg, 0x54, cfg);
+	a5_wr(a5cpu[c].rcg, 0x50, 0x3);
+	for (int i = 0; i < 2000; i++) {
+		if ((a5_rd(a5cpu[c].rcg, 0x50) & 1u) == 0) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* l = 0: the bootloader's state. Returns false (and says why) when a step fails; the cluster is then on GPLL0. */
+static bool
+a5cpu_set(int c, uint32_t l)
+{
+	if (!a5cpu[c].pll) {
+		a5cpu[c].pll = ml_io_map(a5cpu_def[c].pll_pa, 0x1000);
+		a5cpu[c].rcg = ml_io_map(a5cpu_def[c].rcg_pa, 0x1000);
+		if (!a5cpu[c].pll || !a5cpu[c].rcg) {
+			return false;
+		}
+	}
+	if (l == 0) {
+		l = a5cpu_def[c].boot_l;
+	}
+	uint32_t cfg0 = a5_rd(a5cpu[c].rcg, 0x54), l0 = a5_rd(a5cpu[c].pll, 4);
+	if (l != 0 && (l < 30 || l > a5cpu_def[c].max_l)) {
+		printf("SWEET CPUCLK: %s: L %u refused (allowed 30..%u at the boot rail voltage)\n", a5cpu_def[c].name, l, a5cpu_def[c].max_l);
+		return false;
+	}
+	/* park the cluster on GPLL0 (divider field 1, as the bootloader has it for the little cluster) */
+	if ((cfg0 & 0x700u) != 0x400u && !a5cpu_rcg(c, 0x401)) {
+		printf("SWEET CPUCLK: %s: RCG did not move to GPLL0 (CMD 0x%08x CFG 0x%08x); nothing changed\n", a5cpu_def[c].name, a5_rd(a5cpu[c].rcg, 0x50), a5_rd(a5cpu[c].rcg, 0x54));
+		return false;
+	}
+	if (l == 0) {                           /* the little cluster's boot state is GPLL0 itself */
+		a5cpu[c].raised = false;
+		a5cpu[c].l = 0;
+		printf("SWEET CPUCLK: %s back on GPLL0 (RCG CFG 0x%08x)\n", a5cpu_def[c].name, a5_rd(a5cpu[c].rcg, 0x54));
+		return true;
+	}
+	a5_wr(a5cpu[c].pll, 0x0, 0x0);
+	a5_wr(a5cpu[c].pll, 0x4, l);
+	a5_wr(a5cpu[c].pll, 0x0, 0x2);
+	delay(20);
+	a5_wr(a5cpu[c].pll, 0x0, 0x6);
+	delay(200);
+	a5_wr(a5cpu[c].pll, 0x0, 0x7);
+	delay(20);
+	uint32_t mode = a5_rd(a5cpu[c].pll, 0x0), status = a5_rd(a5cpu[c].pll, 0x2c);
+	if (!a5cpu_rcg(c, 0x501)) {
+		printf("SWEET CPUCLK: %s: RCG did not take the PLL (CMD 0x%08x); the cluster stays on GPLL0\n", a5cpu_def[c].name, a5_rd(a5cpu[c].rcg, 0x50));
+		return false;
+	}
+	a5cpu[c].l = l;
+	a5cpu[c].raised = l != a5cpu_def[c].boot_l;
+	printf("SWEET CPUCLK: %s now L %u = %u.%u MHz (was L %u, RCG CFG 0x%08x -> 0x%08x; PLL MODE 0x%08x STATUS 0x%08x)\n", a5cpu_def[c].name, l, l * 192 / 10,
+	    (l * 192) % 10, l0, cfg0, a5_rd(a5cpu[c].rcg, 0x54), mode, status);
+	return true;
+}
+
+static void
+a5cpu_poll(int hottest)
+{
+	for (int c = 0; c < 2; c++) {
+		uint32_t req = a5cpu_request[c];
+		if (req) {
+			a5cpu_request[c] = 0;
+			(void)a5cpu_set(c, req == 1 ? 0 : (req * 10 + 96) / 192);
+		}
+	}
+	if (hottest >= 900 && (a5cpu[0].raised || a5cpu[1].raised)) {
+		printf("SWEET CPUCLK: %d.%d C: CPU clusters back to the bootloader's clocks\n", hottest / 10, hottest % 10);
+		for (int c = 0; c < 2; c++) {
+			if (a5cpu[c].raised) {
+				(void)a5cpu_set(c, 0);
+			}
+		}
+	}
+}
+
 static volatile uint32_t a5clk_request;         /* from sweet_gpu_debug ('FREQ'): MHz to pin, or 1 = governor */
 
 static void
@@ -1563,6 +1675,13 @@ a5_gov_thread(void *arg __unused, wait_result_t wr __unused)
 	if (hi < lo) {
 		hi = lo;
 	}
+	{
+		uint32_t big = 0, little = 0;
+		(void)PE_parse_boot_argn("sweetcpubig", &big, sizeof(big));
+		(void)PE_parse_boot_argn("sweetcpulittle", &little, sizeof(little));
+		a5cpu_request[1] = big;
+		a5cpu_request[0] = little;
+	}
 	bool automatic = gov != 0;
 	if (fix) {
 		bool ok = a5_set_level(a5_level_for(fix, true), true);
@@ -1600,6 +1719,7 @@ a5_gov_thread(void *arg __unused, wait_result_t wr __unused)
 			continue;
 		}
 		int t = a5_hottest(), cap = hi, want = a5clk.level;
+		a5cpu_poll(t);
 		/* ceiling by temperature: one level less per 5 C above `hot`; unknown temperature = at most 465 MHz */
 		if (t < 0) {
 			cap = a5_level_for(465, true);
-- 
2.56.0

