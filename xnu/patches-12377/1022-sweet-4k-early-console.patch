diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
index 3ba05e4..9161b2e 100644
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -3,10 +3,28 @@
 #define _ARM64_SWEET_EARLY_H_
 
 #include <pexpert/arm64/board_config.h>
+
+/*
+ * Where the bootstrap console draws (start.s, arm_vm_init.c, sweet_early.c):
+ *   16K granule: one 32MB L2 block at 0x9c000000 (sweet 0x9c000000 and Poco F1 0x9d400000 splashes)
