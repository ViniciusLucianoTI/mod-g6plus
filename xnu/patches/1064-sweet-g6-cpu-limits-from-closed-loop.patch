From 47da1dbbf78b262b0d451a312f956bc4330292b3 Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Wed, 18 Nov 2026 01:15:43 -0300
Subject: [PATCH] sweet: CPU cluster limits from the measured closed-loop
 voltages: big 2208 MHz, little 1728 MHz

---
 bsd/dev/sweet_a508.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_a508.c b/bsd/dev/sweet_a508.c
index 5a2a3eb78..0bb8a9e2c 100644
--- a/bsd/dev/sweet_a508.c
+++ b/bsd/dev/sweet_a508.c
@@ -1512,8 +1512,14 @@ a5_level_for(uint32_t mhz, bool at_most)
  * If the hottest sensor passes 90 C both clusters go back to what the bootloader had.
  */
 static const struct { const char *name; vm_offset_t pll_pa, rcg_pa; uint32_t boot_l, max_l; } a5cpu_def[2] = {
-	{ "little (cpu4-7)", 0x17916000, 0x17911000, 0, 80 },          /* boot: on GPLL0; up to L 80 = 1536 MHz */
-	{ "big (cpu0-3)", 0x17816000, 0x17811000, 87, 105 },           /* boot: L 87; up to L 105 = 2016 MHz */
+	/*
+	 * Limits from what this phone's own closed-loop CPR settles at under Android with all eight cores loaded
+	 * (read from the PM660 set points, 2026-11-18; S1 feeds the little cluster, S2+S3 the big one):
+	 * little 1382.4/1536/1728/1843.2 MHz = 740/792/860/900 mV against a boot rail of 868 mV;
+	 * big 1670.4/1881.6/2016/2150.4/2208 MHz = 712/756/784/820/852 mV against 872 mV.
+	 */
+	{ "little (cpu4-7)", 0x17916000, 0x17911000, 0, 90 },          /* boot: on GPLL0; up to L 90 = 1728 MHz */
+	{ "big (cpu0-3)", 0x17816000, 0x17811000, 87, 115 },           /* boot: L 87; up to L 115 = 2208 MHz, its maximum */
 };
 static struct { vm_offset_t pll, rcg; uint32_t l; bool raised; } a5cpu[2];
 static volatile uint32_t a5cpu_request[2];      /* MHz asked for per cluster, 0 = none pending, 1 = back to boot */
-- 
2.56.0

