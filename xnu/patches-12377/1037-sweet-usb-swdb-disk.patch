+static int
+swd_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return swd_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+swd_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return swd_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+swd_psize(__unused dev_t dev)
+{
+	return swd.ready ? (int)MIN(swd.nblocks * swd.bsize / swd.secsize, INT_MAX) : -1;
+}
+
+static int
+swd_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(swd_strategy, NULL, dev, B_READ, minphys, uio, (int)swd.secsize);
+}
+
+static int
+swd_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!swd.writable) {
+		return EROFS;
+	}
+	return physio(swd_strategy, NULL, dev, B_WRITE, minphys, uio, (int)swd.secsize);
+}
