+/* Returns true when the command processor ran CP_ME_INIT, left secure mode and executed a register write. */
+static bool
+a5_stage3(void)
+{
+	vm_offset_t kva = 0;
+	if (kmem_alloc_contig(kernel_map, &kva, A5_MEM_SIZE, PAGE_MASK, (ppnum_t)atop_64(0xffffffffull), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: no contiguous memory for the GPU\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	for (unsigned i = 1; pn && i < A5_MEM_SIZE / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(kva + i * PAGE_SIZE)) != pn + i) {
+			pn = 0;
+		}
+	}
+	if (!pn) {
+		printf("SWEET GPU: GPU memory not physically contiguous\n");
+		return false;
+	}
+	sweet_dma_sync_va((const void *)kva, A5_MEM_SIZE);
+	for (unsigned i = 0; i < A5_MEM_SIZE / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	sweet_dma_sync_va((const void *)kva, A5_MEM_SIZE);
+	a5mem = kva;
+	a5mem_pa = ptoa_64(pn);
+	/* 32-bit VA: level 1 (VA[31:30]) -> level 2 (VA[29:21]) -> level 3; AF, SH outer, AP EL0 RW, nG, attr 0 */
+	volatile uint64_t *l1 = (volatile uint64_t *)(a5mem + A5_L1), *l2 = (volatile uint64_t *)(a5mem + A5_L2), *l3 = (volatile uint64_t *)(a5mem + A5_L3);
+	l1[A5_VA >> 30] = (a5mem_pa + A5_L2) | 3ull;
+	l2[(A5_VA >> 21) & 0x1ff] = (a5mem_pa + A5_L3) | 3ull;
+	for (uint32_t off = 0; off < A5_MEM_SIZE - A5_MAPPED; off += 0x1000) {
+		l3[((A5_VA + off) >> 12) & 0x1ff] = (a5mem_pa + A5_MAPPED + off) | 3ull | (1ull << 10) | (2ull << 8) | (1ull << 6) | (1ull << 11);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET GPU: GPU memory 0x%x bytes at PA 0x%llx: tables + GPU VA 0x%08x-0x%08x (PM4 0x%08x PFP 0x%08x ring 0x%08x)\n",
+	    A5_MEM_SIZE, a5mem_pa, A5_VA, A5_VA + A5_MEM_SIZE - A5_MAPPED - 1, A5_VA_PM4, A5_VA_PFP, A5_VA_RB);
+
+	a5smmu = ml_io_map(A5_SMMU_PA, 0x10000);
+	if (!a5smmu || !a5_smmu_setup()) {
+		printf("SWEET GPU: stopped: no SMMU context for the GPU\n");
+		return false;
+	}
+	if (!a5_load_ucode("pm4-firmware", "a530_pm4.fw", A5_VA_PM4, 0x5000) ||
+	    !a5_load_ucode("pfp-firmware", "a530_pfp.fw", A5_VA_PFP, 0x5000)) {
+		return false;
+	}
+	a5_hw_init_regs();
+	gw(A5_CP_ME_INSTR_BASE_LO, A5_VA_PM4);
+	gw(A5_CP_ME_INSTR_BASE_HI, 0);
+	gw(A5_CP_PFP_INSTR_BASE_LO, A5_VA_PFP);
+	gw(A5_CP_PFP_INSTR_BASE_HI, 0);
+	gw(A5_CP_RB_BASE, A5_VA_RB);
+	gw(A5_CP_RB_BASE_HI, 0);
+	/* MSM_GPU_RB_CNTL_DEFAULT (32 KiB ring: log2(bytes / 8) = 12, block size log2(32 / 8) = 2) | NO_UPDATE */
+	gw(A5_CP_RB_CNTL, 12u | (2u << 8) | (1u << 27));
+	gw(A5_RBBM_INT_0_MASK, 0);
+	a5_report("before the micro engine starts");
+	gw(A5_CP_PFP_ME_CNTL, 0);
+
+	a5_ring(A5_PKT7(CP_ME_INIT, 8));
+	a5_ring(0x0000002f);
+	a5_ring(0x00000003);    /* multiple hardware contexts */
+	a5_ring(0x20000000);    /* error detection */
+	a5_ring(0);
+	a5_ring(0);
+	a5_ring(0);             /* no microcode workarounds on the 508 */
+	a5_ring(0);
+	a5_ring(0);
+	if (!a5_submit("CP_ME_INIT")) {
+		return false;
+	}
+	/* The zap shader is loaded: the CP may leave secure mode */
+	a5_ring(A5_PKT7(CP_SET_SECURE_MODE, 1));
+	a5_ring(0);
+	if (!a5_submit("CP_SET_SECURE_MODE 0")) {
+		return false;
+	}
+	/* A register write executed by the CP: scratch register 1, then a NOP */
+	gw(A5_CP_SCRATCH_REG(1), 0);
+	a5_ring(A5_PKT4(A5_CP_SCRATCH_REG(1), 1));
+	a5_ring(0x5085ca7c);
+	a5_ring(A5_PKT7(CP_NOP, 1));
+	a5_ring(0);
+	bool ok = a5_submit("register write + NOP");
+	uint32_t got = gr(A5_CP_SCRATCH_REG(1));
+	printf("SWEET GPU: scratch register 1 reads 0x%08x (%s)\n", got, got == 0x5085ca7c ? "written by the command processor" : "NOT written");
+	a5_report("end of stage 3");
+	return ok && got == 0x5085ca7c;
+}
