+	return (int32_t)x0;
+}
+
+/* patch 1033: PSCI AFFINITY_INFO (0 on, 1 off, 2 on pending) and the per-CPU boot stage markers */
+extern "C" uint8_t sweet_cpu_stage[];
+static int32_t
+sweet_psci_affinity_info(uint64_t target)
+{
+	register uint64_t x0 __asm__("x0") = 0xC4000004ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
 	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
 	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
 	    "x14", "x15", "x16", "x17", "cc", "memory");
 	return (int32_t)x0;
 }
+static unsigned
+sweet_cpu_stage_read(unsigned cpu)
+{
+	volatile uint8_t *slot = &sweet_cpu_stage[(cpu & 7) * 64];
+	/* stage 1 is written with the caches off: drop this CPU's copy of the (never written here) line */
+	__asm__ volatile("dc civac, %0" : : "r"(slot) : "memory");
+	__builtin_arm_isb(ISB_SY);
+	return *slot;
+}
 
