+/*
+ * Payload whitening. On the Moto G6 Plus one particular 64 KiB WRITE (same LBA in every boot of the iOS 16
+ * root) stalled half-way with a host-side I/O error while thousands of other transfers passed: a
+ * data-dependent failure of the physical link. Block payloads are XORed with a fixed pseudo-random
+ * keystream on both ends (HELLO reply flag bit 1), so no payload reaches the wire as a long regular
+ * pattern. xorshift64*, seed 0x9E3779B97F4A7C15, one 64-bit little-endian word per 8 bytes.
+ */
+static uint64_t swd_key[UD_DMAX / 8];
+static bool swd_scramble_on;
+
+static void
+swd_key_init(void)
+{
+	uint64_t x = 0x9E3779B97F4A7C15ULL;
+	for (unsigned i = 0; i < UD_DMAX / 8; i++) {
+		x ^= x >> 12;
+		x ^= x << 25;
+		x ^= x >> 27;
+		swd_key[i] = x * 0x2545F4914F6CDD1DULL;
+	}
+}
+
+static void
+swd_scramble(uint32_t dma_off, uint32_t len, uint32_t seq)
+{
+	uint64_t *p = (uint64_t *)(ud.dma + dma_off);
+	if (!swd_scramble_on) {
+		return;
+	}
+	/*
+	 * The keystream starts at a position that depends on the message's sequence number. The link of the
+	 * Moto G6 Plus has "killer packets": one particular 512-byte packet (the same block of the iOS root in
+	 * every boot) is never acknowledged by the host, however often it is repeated, while a gigabyte of other
+	 * data passes. With a fixed key a retry sends the same bits and fails again; with the rotation a retry
+	 * (new sequence number) is a different bit pattern on the wire.
+	 */
+	uint32_t r = (uint32_t)(((uint64_t)seq * 2654435761u) % (UD_DMAX / 8));
+	for (uint32_t i = 0; i < len / 8; i++) {
+		p[i] ^= swd_key[(i + r) % (UD_DMAX / 8)];
+	}
+}
