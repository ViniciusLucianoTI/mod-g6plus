+/* Root device for rd=usbroot0 (IOFindBSDRoot): start the gadget and wait for the host's disk server. */
+int sweet_usbdisk_rootdev(dev_t *dev);
+
+int
+sweet_usbdisk_rootdev(dev_t *dev)
+{
+	if (swd.ready) {
+		*dev = swd.bdev;
+		return 0;
+	}
+	if (ud.dma == 0 || swd.lock == NULL) {
+		printf("SWEET USBDISK: the USB device is not running (boot-arg sweetusb=2, Moto G6 Plus only for now)\n");
+		return ENXIO;
+	}
+	uint32_t wait_s = 600;
+	PE_parse_boot_argn("usbrootwait", &wait_s, sizeof(wait_s));
+	printf("SWEET USBDISK: waiting up to %u s for tools/g6plus/usbdisk_server.py on the host\n", wait_s);
+	int error = ENXIO;
+	for (uint32_t t = 0; t < wait_s * 4; t++) {
+		if (ud.configured) {
+			error = swd_hello();
+			if (!error) {
+				break;
+			}
+		}
+		if ((t % 40) == 39) {
+			printf("SWEET USBDISK: still waiting for the host (%u s, configured %d, last error %d)\n",
+			    (t + 1) / 4, ud.configured, error);
+		}
+		ud_sleep_ms(250);
+	}
+	if (error) {
+		return error;
+	}
+	uint32_t rw = 0;
+	PE_parse_boot_argn("usbrootrw", &rw, sizeof(rw));
+	swd.writable = swd.writable && rw;
+	swd.bmajor = bdevsw_add(-1, &swd_bdevsw);
+	if (swd.bmajor < 0) {
+		return ENXIO;
+	}
+	swd.cmajor = cdevsw_add_with_bdev(-1, &swd_cdevsw, swd.bmajor);
+	if (swd.cmajor < 0) {
+		return ENXIO;
+	}
+	swd.bdev = makedev(swd.bmajor, 0);
+	devfs_make_node(swd.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "usbroot0");
+	devfs_make_node(makedev(swd.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rusbroot0");
+	swd.ready = true;
+	printf("SWEET USBDISK: usbroot0: %llu blocks of %u bytes (%llu MiB), %s\n", swd.nblocks, swd.bsize,
+	    swd.nblocks * swd.bsize >> 20, swd.writable ? "read-write" : "read-only");
+	*dev = swd.bdev;
+	return 0;
+}
+
+/*
+ * Boot-arg usbdisktest=N (MiB): once the host answers HELLO, read the first N MiB of the image in
+ * 64 KiB requests and print the byte sum and the time, to check the link without mounting anything
+ * (compare with `usbdisk_server.py --sum N IMAGE`).
+ */
+static void
+swd_test_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t mib = 0;
+	PE_parse_boot_argn("usbdisktest", &mib, sizeof(mib));
+	for (int t = 0; t < 2400 && !swd.hello; t++) {
+		if (ud.configured) {
+			(void)swd_hello();
+		}
+		if (!swd.hello) {
+			ud_sleep_ms(250);
+		}
+	}
+	if (!swd.hello) {
+		printf("SWEET USBDISK TEST: no host disk server\n");
+		return;
+	}
+	uint64_t total = MIN((uint64_t)mib << 20, swd.nblocks * swd.bsize), sum = 0, done = 0;
+	uint32_t per = UD_DMAX / swd.bsize;
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	int error = 0;
+	printf("SWEET USBDISK TEST: image %llu blocks of %u, reading %llu bytes\n", swd.nblocks, swd.bsize, total);
+	while (done < total && !error) {
+		uint32_t nblk = (uint32_t)MIN((uint64_t)per, (total - done) / swd.bsize);
+		if (nblk == 0) {
+			break;
+		}
+		lck_mtx_lock(swd.lock);
+		error = swd_request(SWD_READ, done / swd.bsize, nblk, 0, nblk * swd.bsize, 5000);
+		if (!error) {
+			const uint8_t *d = (const uint8_t *)(ud.dma + UD_DRXB + SWD_HDR);
+			for (uint32_t i = 0; i < nblk * swd.bsize; i++) {
+				sum += d[i];
+			}
+		}
+		lck_mtx_unlock(swd.lock);
+		done += (uint64_t)nblk * swd.bsize;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET USBDISK TEST: %s: %llu bytes, byte sum %llu, %llu ms, %llu KiB/s (error %d)\n",
+	    error ? "FAILED" : "done", done, sum, ns / 1000000, ns ? (done >> 10) * 1000000000ULL / ns : 0, error);
+	/*
+	 * Write check (server started with --rw and boot-arg usbrootrw=1): 1 MiB of a known pattern right
+	 * after the area read above, then read back and compared. The host can check the file as well:
+	 * byte i of that MiB is (i * 7 + (i >> 12)) & 0xff.
+	 */
+	uint32_t rw = 0;
+	PE_parse_boot_argn("usbrootrw", &rw, sizeof(rw));
+	if (error || !rw || !swd.writable || total + (1u << 20) > swd.nblocks * swd.bsize) {
+		printf("SWEET USBDISK TEST: write check skipped (usbrootrw %u, host writable %d)\n", rw, swd.writable);
+		return;
+	}
+	uint32_t bad = 0;
+	for (int pass = 0; pass < 2 && !error; pass++) {
+		for (uint32_t off = 0; off < (1u << 20) && !error; off += UD_DMAX) {
+			uint32_t nblk = UD_DMAX / swd.bsize;
+			lck_mtx_lock(swd.lock);
+			if (pass == 0) {
+				uint8_t *o = (uint8_t *)(ud.dma + UD_DTXB + SWD_HDR);
+				for (uint32_t i = 0; i < UD_DMAX; i++) {
+					o[i] = (uint8_t)((off + i) * 7 + ((off + i) >> 12));
+				}
+				error = swd_request(SWD_WRITE, (total + off) / swd.bsize, nblk, UD_DMAX, 0, 5000);
+			} else {
+				error = swd_request(SWD_READ, (total + off) / swd.bsize, nblk, 0, UD_DMAX, 5000);
+				const uint8_t *d = (const uint8_t *)(ud.dma + UD_DRXB + SWD_HDR);
+				for (uint32_t i = 0; i < UD_DMAX && !error; i++) {
+					bad += d[i] != (uint8_t)((off + i) * 7 + ((off + i) >> 12));
+				}
+			}
+			lck_mtx_unlock(swd.lock);
+		}
+	}
+	lck_mtx_lock(swd.lock);
+	int ferr = swd_request(SWD_FLUSH, 0, 0, 0, 0, 10000);
+	lck_mtx_unlock(swd.lock);
+	printf("SWEET USBDISK TEST: write check %s: 1 MiB at byte %llu, %u bad bytes on read-back, error %d, flush %d\n",
+	    (!error && !bad && !ferr) ? "OK" : "FAILED", total, bad, error, ferr);
 }
 
