+/*
+ * ---- patch 1037: "SWDB" vendor interface: kernel log + a block device served by the host ----
+ *
+ * Interface 2 (class 0xff/0x53/0x57), bulk OUT 0x03 (physical ep 6) and bulk IN 0x83 (physical ep 7).
+ * Every message starts with a 512-byte header (little endian):
+ *    0 u32 magic 'SWDB'   4 u32 type   8 u32 seq   12 u32 status   16 u64 lba   24 u32 nblk
+ *   28 u32 len            32 u64 nblocks (HELLO reply)             40 u32 block size (HELLO reply)
+ *   44 u32 flags (HELLO reply: bit 0 writable)                     64 .. inline log text (LOG)
+ * Phone -> host: HELLO 1, READ 2, WRITE 3 (header + len bytes of data), LOG 4 (len <= 448 bytes inline,
+ * no reply), FLUSH 5. Host -> phone: the same header with type | 0x80, for READ followed by the data.
+ * One request at a time (swd.lock); the reply is received into a TRB of exactly the expected size.
+ * The host side is tools/g6plus/usbdisk_server.py (libusb, no network setup, no root).
+ * rd=usbroot0 makes it the root device (IOFindBSDRoot waits for the server). Nothing here may printf
+ * per message: the console feeds the LOG channel.
+ */
+#define SWD_MAGIC       0x42445753u
+#define SWD_HELLO       1u
+#define SWD_READ        2u
+#define SWD_WRITE       3u
+#define SWD_LOG         4u
+#define SWD_FLUSH       5u
+#define SWD_HDR         512u
+#define SWD_LOG_MAX     448u
+
+static struct {
+	lck_mtx_t  *lock;
+	volatile bool rx_done, tx_done;
+	uint32_t    seq;
+	bool        hello;          /* the host answered HELLO */
+	bool        ready;          /* block device registered */
+	bool        writable;
+	uint64_t    nblocks;
+	uint32_t    bsize;
+	uint32_t    secsize;
+	int         bmajor, cmajor;
+	dev_t       bdev;
+	uint64_t    reads, writes, errors, log_msgs;
+} swd;
+
+static inline void
+swd_put32(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dma + off) = v;
+}
+
+static void
+swd_abort(unsigned ep)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.xfer_active[ep]) {
+		ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[ep] << 16), 0, 0, 0);
+		ud.xfer_active[ep] = false;
+	}
+	lck_mtx_unlock(ud.lock);
+}
+
+static int
+swd_wait(volatile bool *flag, unsigned ms)
+{
+	for (unsigned t = 0; t < ms; t++) {
+		if (*flag) {
+			return 0;
+		}
+		if (!ud.configured) {
+			return ENXIO;
+		}
+		ud_sleep_ms(1);
+	}
+	return *flag ? 0 : ETIMEDOUT;
+}
+
+/* swd.lock held. data_out: bytes after the header we send; data_in: bytes after the header we expect. */
+static int
+swd_request(uint32_t type, uint64_t lba, uint32_t nblk, uint32_t data_out, uint32_t data_in, unsigned timeout_ms)
+{
+	if (!ud.configured) {
+		return ENXIO;
+	}
+	uint8_t *h = (uint8_t *)(ud.dma + UD_DTXB);
+	bzero(h, 64);
+	uint32_t seq = ++swd.seq;
+	swd_put32(UD_DTXB + 0, SWD_MAGIC);
+	swd_put32(UD_DTXB + 4, type);
+	swd_put32(UD_DTXB + 8, seq);
+	swd_put32(UD_DTXB + 16, (uint32_t)lba);
+	swd_put32(UD_DTXB + 20, (uint32_t)(lba >> 32));
+	swd_put32(UD_DTXB + 24, nblk);
+	swd_put32(UD_DTXB + 28, data_out);
+
+	swd.rx_done = false;
+	swd.tx_done = false;
+	lck_mtx_lock(ud.lock);
+	if (!ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		return ENXIO;
+	}
+	ud_start_trb(EP_DRX, UD_TRB_DRX, UD_DRXB, SWD_HDR + data_in, TRBCTL_NORMAL);
+	ud_start_trb(EP_DTX, UD_TRB_DTX, UD_DTXB, SWD_HDR + data_out, TRBCTL_NORMAL);
+	lck_mtx_unlock(ud.lock);
+
+	int error = swd_wait(&swd.tx_done, timeout_ms);
+	if (!error) {
+		error = swd_wait(&swd.rx_done, timeout_ms);
+	}
+	if (error) {
+		swd_abort(EP_DTX);
+		swd_abort(EP_DRX);
+		return error;
+	}
+	ud_sync(UD_DRXB, SWD_HDR + data_in);
+	const volatile uint32_t *r = (const volatile uint32_t *)(ud.dma + UD_DRXB);
+	if (r[0] != SWD_MAGIC || r[1] != (type | 0x80u) || r[2] != seq) {
+		return EIO;
+	}
+	return r[3] ? EIO : 0;
+}
+
+static int
+swd_hello(void)
+{
+	lck_mtx_lock(swd.lock);
+	int error = swd_request(SWD_HELLO, 0, 0, 0, 0, 1000);
+	if (!error) {
+		const volatile uint32_t *r = (const volatile uint32_t *)(ud.dma + UD_DRXB);
+		uint64_t nblocks = (uint64_t)r[8] | ((uint64_t)r[9] << 32);
+		uint32_t bsize = r[10];
+		if (nblocks == 0 || bsize < 512 || bsize > 4096 || (bsize & (bsize - 1))) {
+			error = EINVAL;
+		} else {
+			swd.nblocks = nblocks;
+			swd.bsize = bsize;
+			swd.secsize = bsize;
+			swd.writable = (r[11] & 1u) != 0;
+			swd.hello = true;
+		}
+	}
+	lck_mtx_unlock(swd.lock);
+	return error;
+}
+
+/* Console text to the host, 448 bytes per message. Runs from the first configuration on. */
+static void
+swd_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[SWD_LOG_MAX];
+	uint64_t pos = sweet_log_position();
+
+	pos = pos > 262144 ? pos - 262144 : 0;
+	for (;;) {
+		ud_sleep_ms(20);
+		if (!ud.configured) {
+			continue;
+		}
+		for (int burst = 0; burst < 64; burst++) {
+			uint64_t before = pos;
+			uint32_t n = sweet_log_copy(&pos, chunk, sizeof(chunk));
+			if (n == 0) {
+				break;
+			}
+			lck_mtx_lock(swd.lock);
+			uint8_t *h = (uint8_t *)(ud.dma + UD_DLOG);
+			bzero(h, 64);
+			swd_put32(UD_DLOG + 0, SWD_MAGIC);
+			swd_put32(UD_DLOG + 4, SWD_LOG);
+			swd_put32(UD_DLOG + 28, n);
+			memcpy(h + 64, chunk, n);
+			swd.tx_done = false;
+			int error = ENXIO;
+			lck_mtx_lock(ud.lock);
+			if (ud.configured) {
+				ud_start_trb(EP_DTX, UD_TRB_DTX, UD_DLOG, SWD_HDR, TRBCTL_NORMAL);
+				error = 0;
+			}
+			lck_mtx_unlock(ud.lock);
+			if (!error) {
+				error = swd_wait(&swd.tx_done, 200);
+				if (error) {
+					swd_abort(EP_DTX);      /* nobody is reading: keep the text for later */
+				}
+			}
+			lck_mtx_unlock(swd.lock);
+			if (error) {
+				pos = before;
+				ud_sleep_ms(300);
+				break;
+			}
+			swd.log_msgs++;
+		}
+	}
+}
+
+static int
+swd_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!swd.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !swd.writable) ? EROFS : 0;
+}
+
+static int
+swd_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+/* swd.lock held: nblk device blocks at lba, to or from the data area of the reply/request buffers. */
+static int
+swd_rw(bool rd, uint64_t lba, uint32_t nblk)
+{
+	int error = 0;
+	/* The cable can drop and the server can restart: keep trying for a while, a root device must not fail fast. */
+	for (int attempt = 0; attempt < 600; attempt++) {
+		error = rd ? swd_request(SWD_READ, lba, nblk, 0, nblk * swd.bsize, 5000)
+		    : swd_request(SWD_WRITE, lba, nblk, nblk * swd.bsize, 0, 5000);
+		if (!error) {
+			return 0;
+		}
+		swd.errors++;
+		ud_sleep_ms(100);
+	}
+	return error;
+}
+
+static void
+swd_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * swd.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t bytes = swd.nblocks * swd.bsize;
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !swd.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > bytes || count > bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+	lck_mtx_lock(swd.lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / swd.bsize;
+		uint32_t skip = (uint32_t)(pos % swd.bsize);
+		uint32_t want = MIN(count - done, UD_DMAX - skip);
+		uint32_t blocks = (skip + want + swd.bsize - 1) / swd.bsize;
+		if (rd) {
+			error = swd_rw(true, lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)(ud.dma + UD_DRXB + SWD_HDR) + skip, want);
+				swd.reads++;
+			}
+		} else {
+			char *out = (char *)(ud.dma + UD_DTXB + SWD_HDR);
+			if (skip || (want % swd.bsize)) {       /* partial blocks: read, merge, write back */
+				error = swd_rw(true, lba, blocks);
+				if (!error) {
+					memcpy(out, (const char *)(ud.dma + UD_DRXB + SWD_HDR), blocks * swd.bsize);
+				}
+			}
+			if (!error) {
+				memcpy(out + skip, vaddr + done, want);
+				error = swd_rw(false, lba, blocks);
+				swd.writes++;
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(swd.lock);
+	buf_unmap(bp);
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+swd_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = swd.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > swd.bsize || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		swd.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = swd.bsize;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = swd.nblocks * swd.bsize / swd.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = swd.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!swd.writable) {
+			return 0;
+		}
+		lck_mtx_lock(swd.lock);
+		int error = swd_request(SWD_FLUSH, 0, 0, 0, 0, 10000);
+		lck_mtx_unlock(swd.lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = UD_DMAX / swd.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = swd.writable ? UD_DMAX / swd.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
