diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index a4f5697..5856516 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -1,9 +1,10 @@
 /*
  * Board config for the Redmi Note 10 Pro ("sweet", Qualcomm SM7150 /
  * Snapdragon 732G): Kryo 470 = Cortex-A76 + Cortex-A55, ARMv8.2, no PAC.
+ * Also used for the Poco F1 (SDM845) and the Moto G6 Plus (SDM630, ARMv8.0).
  *
  * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
- * implementation-defined system registers exist), 16K pages and GICv3 like
+ * implementation-defined system registers exist), 4K pages and GICv3 like
  * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
  * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
  * including the timer, is a Group 1 IRQ taken through sleh_irq().
@@ -33,8 +34,16 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-#define __ARM_PAN_AVAILABLE__     1
-#define __ARM_16K_PG__            1
+/*
+ * ARMv8.0 baseline (patch 1021) so one kernel runs on SDM630 (Moto G6 Plus,
+ * Kryo 260 Silver = Cortex-A53 class) as well as on the v8.2 Kryo 385/470:
+ *  - no __ARM_PAN_AVAILABLE__: PAN is ARMv8.1 (MSR PAN is UNDEFINED on the A53);
+ *  - no __ARM_16K_PG__: the A53 has no 16K translation granule
+ *    (ID_AA64MMFR0_EL1.TGran16 = 0). The hardware pages are 4K; with more
+ *    than 1 GB of RAM arm_init() still selects 16K VM pages (PAGE_SHIFT_CONST
+ *    = 14, PAGE_RATIO 4), the H6/H7 (A7/A8) arrangement, so userland keeps
+ *    seeing 16K pages.
+ */
 
 #define HAS_GIC_V3                1
 
