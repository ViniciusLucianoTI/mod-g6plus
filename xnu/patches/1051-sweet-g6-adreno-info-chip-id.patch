From 1e32d2b3a766a6c96f678cc3fe0899cbd1b74016 Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Fri, 13 Nov 2026 00:11:28 -0300
Subject: [PATCH] SweetAdreno: INFO chip id from the driver

---
 iokit/Kernel/arm/SweetAdreno.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
index 1ce7b9d03..b869464a8 100644
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -933,7 +933,11 @@ SweetAdrenoUserClient::externalMethod(uint32_t selector, IOExternalMethodArgumen
 		r.info.abi_version = SWEET_GPU_ABI_VERSION;
 		r.info.flags = sweet_gpu_ready() ? 1u : 2u;
 		r.info.gpu_id = 630;
-		r.info.chip_id = 0x06030001;
+		{
+			uint64_t chip = 0x06030001;
+			(void)sweet_gpu_param(3, &chip);        /* 0x05000800 on the Moto G6 Plus */
+			r.info.chip_id = (uint32_t)chip;
+		}
 		r.info.va_start = sweet_gpu_param(SWEET_MSM_PARAM_VA_START, &v) ? v : 0;
 		r.info.va_size = sweet_gpu_param(SWEET_MSM_PARAM_VA_SIZE, &v) ? v : 0;
 		r.info.last_fence = sweet_gpu_ready() ? sweet_gpu_fence_last() : 0;
-- 
2.56.0

