diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba9b..10aae02ed 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,24 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if __ARM_FEATURE_ATOMICS
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#else
+	/*
+	 * SWEET (patch 1021, ARMv8.0 / Cortex-A53: no LSE): the same one-shot trylock
+	 * with LDAXR/STXR. w10 = old value (0 = we got it); only a spurious STXR
+	 * failure retries. Caller-save registers only (w12 scratch).
+	 */
+Lsweet_enq_ldaxr:
+	ldaxr	w10, [x3]
+	cbnz	w10, Lsweet_enq_busy
+	stxr	w12, w11, [x3]
+	cbnz	w12, Lsweet_enq_ldaxr
+	b	Lsweet_enq_done
+Lsweet_enq_busy:
+	clrex
+Lsweet_enq_done:
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +340,24 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if __ARM_FEATURE_ATOMICS
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#else
+	/*
+	 * SWEET (patch 1021, ARMv8.0 / Cortex-A53: no LSE): the same one-shot trylock
+	 * with LDAXR/STXR. w10 = old value (0 = we got it); only a spurious STXR
+	 * failure retries. Caller-save registers only (w12 scratch).
+	 */
+Lsweet_deq_ldaxr:
+	ldaxr	w10, [x2]
+	cbnz	w10, Lsweet_deq_busy
+	stxr	w12, w11, [x2]
+	cbnz	w12, Lsweet_deq_ldaxr
+	b	Lsweet_deq_done
+Lsweet_deq_busy:
+	clrex
+Lsweet_deq_done:
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 42b778696..2857ff9ea 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10894,6 +10894,13 @@ pmap_create_commpages(vm_map_address_t *kernel_data_addr, vm_map_address_t *kern
 
 	do {
 		int text_leaf_index = random() % num_ptes;
+		/*
+		 * SWEET (patch 1024): with a 4K kernel and 16K VM pages (PAGE_RATIO 4, SDM630) pmap_enter maps one
+		 * VM page as PAGE_SIZE / leaf-size consecutive PTEs and asserts that the first is aligned
+		 * (write_pte_fast "PTE write is unaligned", QEMU cortex-a53): keep the slid text commpage on a VM page
+		 * boundary. A no-op when the leaf size is PAGE_SIZE.
+		 */
+		text_leaf_index &= ~(int)((PAGE_SIZE >> pt_attr_leaf_shift(pt_attr)) - 1);
 
 		// Generate a VA for the commpage text with the same root and twig index as data
 		// comm page, but with new leaf index we've just generated.
@@ -10983,11 +10990,24 @@ static_assert((_COMM_PAGE32_BASE_ADDRESS & ~ARM_TT_L2_OFFMASK) >= VM_MAX_ADDRESS
  */
 
 #elif (ARM_PGSHIFT == 12)
+#if defined(SWEET)
+/**
+ * SWEET 4K granule (SDM630, patch 1021) with the extended user VA
+ * (MACH_VM_MAX_ADDRESS 0x7FFFFE000000): like the 16K macOS case above, the
+ * commpage lies inside the user VA range. With 4K pages it is nested at L1, so
+ * what must hold is that the 1GB L1 entry holding it is exactly the commpage
+ * nesting region every user map reserves (vm_reserved_regions[], "commpage
+ * nesting"), so no user mapping can land in the shared table.
+ */
+static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) == _COMM_PAGE64_NESTING_START);
+static_assert(_COMM_PAGE64_NESTING_SIZE == ARM_TT_L1_SIZE);
+#else
 /**
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
  * above the maximum userspace VA.
  */
 static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+#endif /* SWEET */
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
diff --git a/osfmk/arm/pmap/pmap.h b/osfmk/arm/pmap/pmap.h
