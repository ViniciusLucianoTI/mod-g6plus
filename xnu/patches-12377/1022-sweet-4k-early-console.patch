diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 52f5a7d..60a2531 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1844,6 +1844,49 @@ sweet_early_map_final(void)
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
+#elif defined(SWEET)
+/*
+ * 4K granule (patch 1022): the same idea with SWEET_EARLY_FB_BLOCKS 2MB blocks right above the
+ * low-globals block. With the small-memory layout (patch 1023) VM_MIN_KERNEL_ADDRESS has no tables
+ * yet, but LOW_GLOBAL_BASE_ADDRESS (0xfffffff000000000) shares its 1GB L1 entry with the kernel
+ * (0xfffffff007004000), and L2 slots 1-6 of that table lie between the low globals and the kernel.
+ * Every condition is checked instead of asserted: a failed placement only turns the early console
+ * back into a log (sweet_early_fb_mapped = 0) instead of an invisible panic.
+ */
+#define SWEET_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE)
+
+static void
+sweet_early_map_final(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	const unsigned int n = SWEET_EARLY_FB_BLOCKS;
+
+	if (!sweet_early_fb_mapped) {
+		return;
+	}
+	/* the 4K kernel root is a sub-page L1 (T1SZ_BOOT 26): index it like arm_vm_init does */
+	tt_entry_t l1 = cpu_tte[L1_TABLE_T1_INDEX(va, TCR_EL1_BOOT)];
+	unsigned int idx = (unsigned int)((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+	if (va + n * ARM_TT_L2_SIZE > gVirtBase || idx + n > TTE_PGENTRIES ||
+	    (l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		sweet_early_fb_mapped = 0;
+		return;
+	}
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	for (unsigned int i = 0; i < n; i++) {
+		if (l2[idx + i] != ARM_TTE_EMPTY) {
+			sweet_early_fb_mapped = 0;
+			return;
+		}
+	}
+	for (unsigned int i = 0; i < n; i++) {
+		l2[idx + i] = ((uint64_t)SWEET_EARLY_FB_PA + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
 #endif
 
 void
@@ -2200,7 +2243,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	kasan_init();
 #endif /* KASAN */
 
-#if defined(SWEET) && __ARM_16K_PG__
+#if defined(SWEET)
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
 #endif
@@ -2209,9 +2252,11 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-#if defined(SWEET) && __ARM_16K_PG__
-	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+#if defined(SWEET)
+	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias (4K: only if placed). */
+	if (sweet_early_fb_mapped) {
+		sweet_early_relocate(SWEET_EARLY_FB_VA);
+	}
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 3225e83..2fdcfa8 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -35,6 +35,9 @@
 #include <machine/asm.h>
 #include <arm64/tunables/tunables.s>
 #include <arm64/exception_asm.h>
+#if defined(SWEET)
+#include <arm64/sweet_early.h>
+#endif
 
 #if __ARM_KERNEL_PROTECT__
 #include <arm/pmap.h>
@@ -707,6 +710,49 @@ Lkernelcache_base_found:
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
+#if defined(SWEET) && !__ARM_16K_PG__
+	/*
+	 * 4K granule (patch 1022): the splash window SWEET_EARLY_FB_PA as SWEET_EARLY_FB_BLOCKS 2MB
+	 * Normal-NC blocks in the V=P L2 table that create_bootstrap_mapping made for the RAM of the
+	 * same 1GB (0x80000000-0xbfffffff on SDM630 and SDM845), found through the V=P L1 table (x25).
+	 * Nothing is written if that L1 entry is not a table or a slot is already used; then
+	 * sweet_early_fb_mapped stays 0 and the early console only logs.
+	 */
+	MOV64	x10, SWEET_EARLY_FB_PA
+	lsr		x12, x10, #(ARM_TT_L1_SHIFT)
+	and		x12, x12, #(TTE_PGENTRIES - 1)
+	ldr		x13, [x25, x12, lsl #TTE_SHIFT]
+	and		x11, x13, #3
+	cmp		x11, #3								// valid table descriptor
+	b.ne	Lsweet_fb4k_done
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
+	lsr		x12, x10, #(ARM_TT_L2_SHIFT)
+	and		x12, x12, #(TTE_PGENTRIES - 1)
+	cmp		x12, #(TTE_PGENTRIES - SWEET_EARLY_FB_BLOCKS)
+	b.hi	Lsweet_fb4k_done					// the window must not cross the L2 table
+	add		x13, x13, x12, lsl #TTE_SHIFT		// &l2[first]
+	mov		x16, #0
+Lsweet_fb4k_check:
+	ldr		x17, [x13, x16, lsl #TTE_SHIFT]
+	cbnz	x17, Lsweet_fb4k_done
+	add		x16, x16, #1
+	cmp		x16, #(SWEET_EARLY_FB_BLOCKS)
+	b.lo	Lsweet_fb4k_check
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	mov		x16, #0
+Lsweet_fb4k_set:
+	str		x11, [x13, x16, lsl #TTE_SHIFT]
+	add		x11, x11, #(ARM_TT_L2_SIZE)
+	add		x16, x16, #1
+	cmp		x16, #(SWEET_EARLY_FB_BLOCKS)
+	b.lo	Lsweet_fb4k_set
+	adrp	x16, EXT(sweet_early_fb_mapped)@page	// MMU off: PC-relative = physical
+	add		x16, x16, EXT(sweet_early_fb_mapped)@pageoff
+	mov		w17, #1
+	str		w17, [x16]
+Lsweet_fb4k_done:
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
