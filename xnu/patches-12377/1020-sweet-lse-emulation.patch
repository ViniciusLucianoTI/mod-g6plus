+/*
+ * SWEET: the LSE emulation's user memory accesses (sleh.c, sweet_lseemu.h). size is log2 of
+ * the access (0..3). Return 0, EFAULT, EINVAL (misaligned, tagged) or EAGAIN (the exclusive
+ * never succeeded). Like copyout_atomic64 they need natural alignment and do not allow
+ * kernel-to-kernel copies. Always the privileged path (WRAP_COPYIO_PAN): exclusives have
+ * no unprivileged LDTR/STTR form, and the target CPUs have no MTE.
+ */
+int
+sweet_lse_user_cas(user_addr_t user_addr, unsigned size, uint64_t expected, uint64_t desired, uint64_t *old)
+{
+	vm_map_t map = current_thread()->map;
+	int result = copy_validate(map, user_addr, 0, (vm_size_t)1 << size,
+	    COPYIO_OUT | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+
+	user_addr_t guarded_user_addr = copy_ensure_address_space_spec(map, user_addr);
+
+	return WRAP_COPYIO_PAN(USER_ACCESS_WRITE, map,
+	           _sweet_lse_cas(guarded_user_addr, expected, desired, old, size));
+}
+
+int
+sweet_lse_user_cas128(user_addr_t user_addr, uint64_t exp_lo, uint64_t exp_hi, uint64_t des_lo, uint64_t des_hi,
+    uint64_t *old_lo, uint64_t *old_hi)
+{
+	vm_map_t map = current_thread()->map;
+	uint64_t old[2] = {0, 0};
+	int result = copy_validate(map, user_addr, 0, 16,
+	    COPYIO_OUT | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+
+	user_addr_t guarded_user_addr = copy_ensure_address_space_spec(map, user_addr);
+
+	result = WRAP_COPYIO_PAN(USER_ACCESS_WRITE, map,
+	    _sweet_lse_cas128(guarded_user_addr, exp_lo, exp_hi, des_lo, des_hi, old));
+	*old_lo = old[0];
+	*old_hi = old[1];
+	return result;
+}
+
+int
+sweet_lse_user_load(user_addr_t user_addr, unsigned size, uint64_t *val)
+{
+	vm_map_t map = current_thread()->map;
+	int result = copy_validate(map, user_addr, 0, (vm_size_t)1 << size,
+	    COPYIO_IN | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+
+	user_addr_t guarded_user_addr = copy_ensure_address_space_spec(map, user_addr);
+
+	return WRAP_COPYIO_PAN(USER_ACCESS_READ, map,
+	           _sweet_lse_load(guarded_user_addr, val, size));
+}
+
