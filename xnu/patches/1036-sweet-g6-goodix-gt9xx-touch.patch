From 261ed30bbb755fbfdf5312b41b2217530cc77780 Mon Sep 17 00:00:00 2001
From: ViniciusLucianoTI <viniciusluciano2012@hotmail.com>
Date: Thu, 12 Nov 2026 11:10:39 -0300
Subject: [PATCH] sweet g6: Goodix GT9xx touch screen on evert (bit-banged I2C
 on TLMM 10/11, rail through a minimal RPM G-Link client)

---
 bsd/dev/sweet_touch.c | 464 ++++++++++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_usb.c   |   2 +
 2 files changed, 466 insertions(+)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 1ae50ee1b..640512db1 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1187,6 +1187,470 @@ out:
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * Moto G6 Plus (evert, SDM630): Goodix GT9xx at 0x5d on BLSP1 QUP3 (Android: i2c-3, "gt9xx-mmi"), SDA/SCL
+ * TLMM 10/11 (function blsp_i2c3), IRQ TLMM 67, reset TLMM 66; all four pins are in the NORTH tile, which on
+ * SDM630/660 is at 0x03900000 (Linux pinctrl-sdm660.c, sdm630.dtsi; 0x03100000 is SOUTH: its pin 10 slot reads 0
+ * and a write there is an SError). No BLSP QUP driver here: the bus is
+ * bit-banged on its pins as GPIOs, like the Poco F1's. Protocol as Linux drivers/input/touchscreen/goodix.c:
+ * product id (ASCII) at 0x8140, config at 0x8047 (x/y resolution LE at +1/+3), status at 0x814e (bit 7 =
+ * report ready, low nibble = contacts), 8-byte contacts from 0x814f [id, x LE, y LE, size LE, 0]; a zero
+ * written to 0x814e acknowledges. The reset sequence holds INT low so the chip answers at 0x5d.
+ * sweet_ufs_init(), which starts the touch thread on the Xiaomi boards, does not run on evert:
+ * sweet_usb_start_evert() calls this. Boot-args: sweettouch=1 to enable (default off on evert),
+ * sweettouchdelay=S, sweettouchms, sweettouchbb, sweettouchlog=1.
+ */
+#define EVERT_TLMM_NORTH 0x03900000u     /* sdm630.dtsi reg-names: south 0x03100000, center 0x03500000, north 0x03900000 */
+#define GT9_ADDR         0x5du
+#define GT9_ID_REG       0x8140u
+#define GT9_CFG_REG      0x8047u
+#define GT9_STATUS_REG   0x814eu
+
+static const struct touch_board touch_evert = {
+	"BLSP1 QUP3 (bit-banged)", 0, 0, 0, 0,
+	10, 11, 0, 67, 66, 1080, 2160, false,
+};
+
+/*
+ * SDM630 RPM client, just enough to switch one regulator on. The GT9xx's rail is pm660l_l3 (RPM resource
+ * "ldob" 3), used by nothing else, so ABL hands it over off and the chip does not answer on the bus.
+ * Transport and protocol as Linux drivers/rpmsg/qcom_glink_rpm.c + qcom_glink_native.c (intentless G-Link
+ * over two FIFOs in the RPM message RAM 0x00778000+0x7000, found through the table of contents in its last
+ * 256 bytes; the RPM is kicked through bit 0 of 0x17911008), drivers/soc/qcom/smd-rpm.c (channel
+ * "rpm_requests", "req" packets) and drivers/regulator/qcom_smd-regulator.c (keys "swen", "uv").
+ * Polled, one caller (the touch thread).
+ */
+#define ERPM_RAM_PA      0x00778000u
+#define ERPM_RAM_SIZE    0x7000u
+#define ERPM_IPC_PA      0x17911000u
+#define ERPM_IPC_REG     0x8u
+#define ERPM_TOC_MAGIC   0x67727430u
+#define ERPM_TX_ID       0x61703272u
+#define ERPM_RX_ID       0x72326170u
+#define GL_VERSION       0u
+#define GL_VERSION_ACK   1u
+#define GL_OPEN          2u
+#define GL_CLOSE         3u
+#define GL_OPEN_ACK      4u
+#define GL_TX_DATA       9u
+#define GL_CLOSE_ACK     11u
+#define GL_TX_DATA_CONT  12u
+#define GL_INTENTLESS    2u
+#define ERPM_LCID        1u
+
+static struct {
+	vm_offset_t ram, ipc;
+	uint32_t tx_off, tx_len, rx_off, rx_len;
+	bool ver_ack, open_ack, remote_open, up;
+	uint32_t msg_id, acked_id, err;
+	char errtext[40];
+} erpm;
+
+static uint32_t
+erpm_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(erpm.ram + off);
+}
+
+static void
+erpm_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(erpm.ram + off) = v;
+}
+
+/* FIFO at off: tail, head, data. len and every message are multiples of 4. */
+static uint32_t
+erpm_rx_avail(void)
+{
+	uint32_t head = erpm_rd(erpm.rx_off + 4), tail = erpm_rd(erpm.rx_off);
+	return head < tail ? erpm.rx_len - tail + head : head - tail;
+}
+
+static void
+erpm_rx_peek(uint32_t *dst, uint32_t offset, uint32_t count)
+{
+	uint32_t tail = erpm_rd(erpm.rx_off) + offset;
+	for (uint32_t i = 0; i < count; i += 4) {
+		if (tail >= erpm.rx_len) {
+			tail -= erpm.rx_len;
+		}
+		dst[i / 4] = erpm_rd(erpm.rx_off + 8 + tail);
+		tail += 4;
+	}
+}
+
+static void
+erpm_rx_advance(uint32_t count)
+{
+	uint32_t tail = erpm_rd(erpm.rx_off) + count;
+	if (tail >= erpm.rx_len) {
+		tail -= erpm.rx_len;
+	}
+	erpm_wr(erpm.rx_off, tail);
+}
+
+static bool
+erpm_tx(const uint32_t *src, uint32_t count)        /* count: multiple of 8 */
+{
+	uint32_t head = erpm_rd(erpm.tx_off + 4), tail = erpm_rd(erpm.tx_off);
+	uint32_t avail = tail <= head ? erpm.tx_len - head + tail : tail - head;
+	if (avail <= count) {
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i += 4) {
+		erpm_wr(erpm.tx_off + 8 + head, src[i / 4]);
+		head += 4;
+		if (head >= erpm.tx_len) {
+			head -= erpm.tx_len;
+		}
+	}
+	erpm_wr(erpm.tx_off + 4, head);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(erpm.ipc + ERPM_IPC_REG) = 1u;
+	return true;
+}
+
+static void
+erpm_cmd(uint32_t cmd, uint32_t p1, uint32_t p2)
+{
+	uint32_t m[2] = {cmd | (p1 << 16), p2};
+	(void)erpm_tx(m, 8);
+}
+
+/* Handle what the RPM sent; returns after ms milliseconds or when *flag is set. */
+static void
+erpm_pump(const bool *flag, unsigned ms)
+{
+	for (unsigned t = 0; t <= ms; t++) {
+		while (erpm_rx_avail() >= 8) {
+			uint32_t m[2], d[72];
+			erpm_rx_peek(m, 0, 8);
+			uint32_t cmd = m[0] & 0xffffu, p1 = m[0] >> 16, p2 = m[1];
+			if (cmd == GL_VERSION) {
+				erpm_rx_advance(8);
+				erpm_cmd(GL_VERSION_ACK, 1, GL_INTENTLESS);
+			} else if (cmd == GL_VERSION_ACK) {
+				erpm_rx_advance(8);
+				erpm.ver_ack = true;
+			} else if (cmd == GL_OPEN) {
+				uint32_t need = 8 + ((p2 + 7u) & ~7u);
+				if (erpm_rx_avail() < need) {
+					break;
+				}
+				erpm_rx_advance(need);
+				erpm_cmd(GL_OPEN_ACK, p1, 0);
+				erpm.remote_open = true;
+			} else if (cmd == GL_OPEN_ACK) {
+				erpm_rx_advance(8);
+				erpm.open_ack = true;
+			} else if (cmd == GL_CLOSE) {
+				erpm_rx_advance(8);
+				erpm_cmd(GL_CLOSE_ACK, p1, 0);
+			} else if (cmd == GL_TX_DATA || cmd == GL_TX_DATA_CONT) {
+				uint32_t h[4];
+				if (erpm_rx_avail() < 16) {
+					break;
+				}
+				erpm_rx_peek(h, 0, 16);
+				uint32_t chunk = h[2], total = (16 + chunk + 7u) & ~7u;
+				if (erpm_rx_avail() < 16 + chunk) {
+					break;
+				}
+				uint32_t n = MIN((chunk + 3u) & ~3u, (uint32_t)sizeof(d));
+				bzero(d, sizeof(d));
+				erpm_rx_peek(d, 16, n);
+				erpm_rx_advance(total);
+				/* "req" header (service, length), then stacked messages: type, length, msg id or error text */
+				if (n >= 20 && d[0] == 0x00716572u) {
+					uint32_t end = MIN(8 + d[1], n);
+					for (uint32_t o = 8; o + 12 <= end;) {
+						uint32_t type = d[o / 4], len = d[o / 4 + 1];
+						if (type == 0x2367736du) {
+							erpm.acked_id = d[o / 4 + 2];
+						} else if (type == 0x00727265u) {
+							erpm.err = 1;
+							strlcpy(erpm.errtext, (const char *)&d[o / 4 + 2], MIN(sizeof(erpm.errtext), (size_t)len + 1));
+						}
+						o += 8 + ((len + 3u) & ~3u);
+						if (len == 0) {
+							break;
+						}
+					}
+				}
+			} else {
+				erpm_rx_advance(8);
+			}
+		}
+		if ((flag && *flag) || t == ms) {
+			return;
+		}
+		touch_wait(1);
+	}
+}
+
+static bool
+erpm_connect(void)
+{
+	if (erpm.up) {
+		return true;
+	}
+	erpm.ram = ml_io_map(ERPM_RAM_PA, ERPM_RAM_SIZE);
+	erpm.ipc = ml_io_map(ERPM_IPC_PA, 0x1000);
+	if (!erpm.ram || !erpm.ipc) {
+		printf("SWEET RPM: mapping failed\n");
+		return false;
+	}
+	uint32_t toc = ERPM_RAM_SIZE - 256u;
+	uint32_t count = erpm_rd(toc + 4);
+	if (erpm_rd(toc) != ERPM_TOC_MAGIC || count > 20) {
+		printf("SWEET RPM: no table of contents in the message RAM (magic %#x count %u)\n", erpm_rd(toc), count);
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t id = erpm_rd(toc + 8 + i * 12), off = erpm_rd(toc + 12 + i * 12), size = erpm_rd(toc + 16 + i * 12);
+		if (off > ERPM_RAM_SIZE || off + size > ERPM_RAM_SIZE || size < 64 || (size & 3u)) {
+			continue;
+		}
+		if (id == ERPM_TX_ID) {
+			erpm.tx_off = off;
+			erpm.tx_len = size;
+		} else if (id == ERPM_RX_ID) {
+			erpm.rx_off = off;
+			erpm.rx_len = size;
+		}
+	}
+	if (!erpm.tx_len || !erpm.rx_len) {
+		printf("SWEET RPM: FIFOs not found in the table of contents (%u entries)\n", count);
+		return false;
+	}
+	printf("SWEET RPM: tx fifo %#x+%u (tail %u head %u), rx fifo %#x+%u (tail %u head %u)\n",
+	    erpm.tx_off, erpm.tx_len, erpm_rd(erpm.tx_off), erpm_rd(erpm.tx_off + 4),
+	    erpm.rx_off, erpm.rx_len, erpm_rd(erpm.rx_off), erpm_rd(erpm.rx_off + 4));
+	/* as Linux's probe: pristine FIFOs, then the version handshake and the channel */
+	erpm_wr(erpm.tx_off + 4, 0);
+	erpm_wr(erpm.rx_off, 0);
+	erpm_cmd(GL_VERSION, 1, GL_INTENTLESS);
+	erpm_pump(&erpm.ver_ack, 1000);
+	if (!erpm.ver_ack) {
+		printf("SWEET RPM: no version ack (rx tail %u head %u, tx tail %u head %u)\n",
+		    erpm_rd(erpm.rx_off), erpm_rd(erpm.rx_off + 4), erpm_rd(erpm.tx_off), erpm_rd(erpm.tx_off + 4));
+		return false;
+	}
+	uint32_t open[6] = {GL_OPEN | (ERPM_LCID << 16), 13, 0, 0, 0, 0};
+	memcpy(&open[2], "rpm_requests", 13);
+	(void)erpm_tx(open, 24);
+	erpm_pump(&erpm.open_ack, 1000);
+	erpm_pump(&erpm.remote_open, 300);
+	printf("SWEET RPM: channel rpm_requests: open ack %d, remote open %d\n", erpm.open_ack, erpm.remote_open);
+	erpm.up = erpm.open_ack;
+	return erpm.up;
+}
+
+/* Active-set request: regulator type (e.g. "ldob" 0x626f646c) id on at uv microvolts. 0 or an errno. */
+static int
+erpm_vreg_enable(uint32_t type, uint32_t id, uint32_t uv)
+{
+	if (!erpm_connect()) {
+		return ENXIO;
+	}
+	uint32_t m[18];
+	bzero(m, sizeof(m));
+	uint32_t mid = ++erpm.msg_id;
+	m[0] = GL_TX_DATA | (ERPM_LCID << 16);
+	m[1] = 0;                       /* intent id */
+	m[2] = 52;                      /* chunk size */
+	m[3] = 0;                       /* left */
+	m[4] = 0x00716572u;             /* "req" */
+	m[5] = 20 + 24;
+	m[6] = mid;
+	m[7] = 0;                       /* active set */
+	m[8] = type;
+	m[9] = id;
+	m[10] = 24;
+	m[11] = 0x6e657773u;            /* "swen" */
+	m[12] = 4;
+	m[13] = 1;
+	m[14] = 0x00007675u;            /* "uv" */
+	m[15] = 4;
+	m[16] = uv;
+	erpm.err = 0;
+	erpm.errtext[0] = 0;
+	if (!erpm_tx(m, 72)) {
+		return EAGAIN;
+	}
+	for (int t = 0; t < 2000 && erpm.acked_id != mid && !erpm.err; t++) {
+		erpm_pump(NULL, 1);
+	}
+	if (erpm.err) {
+		printf("SWEET RPM: request %u refused: '%s'\n", mid, erpm.errtext);
+		return EIO;
+	}
+	if (erpm.acked_id != mid) {
+		printf("SWEET RPM: request %u not acknowledged (last ack %u)\n", mid, erpm.acked_id);
+		return ETIMEDOUT;
+	}
+	return 0;
+}
+
+static int
+gt9_write8(uint16_t reg, uint8_t v)
+{
+	const uint8_t msg[3] = {(uint8_t)(reg >> 8), (uint8_t)reg, v};
+	return bb_xfer(GT9_ADDR, msg, sizeof(msg), NULL, 0);
+}
+
+static void
+touch_evert_thread(void *arg __unused, wait_result_t result __unused)
+{
+	unsigned delay_s = 20;
+	uint8_t id[6], cfg[8], buf[1 + 8 * TOUCH_MAX];
+	int err = 0;
+
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: evert GT9xx, starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	st.gpio = ml_io_map(EVERT_TLMM_NORTH, 0x48000);
+	if (!st.gpio) {
+		printf("SWEET TOUCH: TLMM mapping failed\n");
+		goto out;
+	}
+	st.bitbang = true;
+	{
+		/* the chip's rail; sweettouchuv=0 leaves the RPM alone */
+		uint32_t uv = 2600000;  /* Android: pm660l_l3 enabled at 2.6 V, one user (GT917D, fw 0x6009) */
+		(void)PE_parse_boot_argn("sweettouchuv", &uv, sizeof(uv));
+		if (uv) {
+			int e = erpm_vreg_enable(0x626f646cu, 3, uv);
+			printf("SWEET TOUCH: pm660l_l3 on at %u uV through the RPM -> %d\n", uv, e);
+			touch_wait(30);
+		}
+	}
+	printf("SWEET TOUCH: TLMM as left by ABL: sda%u=%#x/%#x scl%u=%#x/%#x irq%u=%#x/%#x rst%u=%#x/%#x\n",
+	    tb->sda, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->sda)),
+	    tb->scl, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->scl)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->scl)),
+	    tb->irq, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    tb->rst, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)));
+	/* bus pins: plain GPIO inputs with the internal pull-up (the board's pull-ups hang off the touch rail) */
+	touch_gpio(tb->sda, 0, 3, 0, false, false);
+	touch_gpio(tb->scl, 0, 3, 0, false, false);
+	/* reset with INT low: address 0x5d (0xba/0xbb) */
+	touch_gpio(tb->irq, 0, 0, 0, true, false);
+	touch_gpio(tb->rst, 0, 0, 0, true, false);
+	touch_wait(20);
+	touch_gpio(tb->rst, 0, 0, 0, true, true);
+	touch_wait(10);
+	touch_wait(50);
+	touch_gpio(tb->irq, 0, 0, 0, false, false);
+	touch_wait(50);
+	printf("SWEET TOUCH: after reset: sda=%d scl=%d irq=%d\n", bb_get(tb->sda), bb_get(tb->scl), bb_get(tb->irq));
+	st.probing = true;
+	for (int tries = 0; tries < 3; tries++) {
+		memset(id, 0, sizeof(id));
+		err = touch_read(GT9_ADDR, GT9_ID_REG, true, id, sizeof(id));
+		if (!err) {
+			break;
+		}
+		touch_wait(100);
+	}
+	if (err) {
+		/* INT high at reset selects 0x14 instead: tell which one answers */
+		uint8_t alt[4] = {0};
+		int e2 = touch_read(0x14, GT9_ID_REG, true, alt, sizeof(alt));
+		st.probing = false;
+		printf("SWEET TOUCH: no GT9xx at 0x5d (error %d; 0x14 -> error %d %02x %02x %02x %02x). "
+		    "Rail off (pm660l_l3) or wrong pins: touch not started\n", err, e2, alt[0], alt[1], alt[2], alt[3]);
+		goto out;
+	}
+	st.probing = false;
+	unsigned cw = tb->w, ch = tb->h;
+	if (!touch_read(GT9_ADDR, GT9_CFG_REG, true, cfg, sizeof(cfg))) {
+		unsigned w = cfg[1] | (cfg[2] << 8), h = cfg[3] | (cfg[4] << 8);
+		printf("SWEET TOUCH: GT9xx config version %#x, %ux%u, %u contacts, trigger %#x\n", cfg[0], w, h, cfg[5] & 0xf, cfg[6]);
+		if (w >= 240 && w <= 4096 && h >= 240 && h <= 4096) {
+			cw = w;
+			ch = h;
+		}
+	}
+	printf("SWEET TOUCH: GT9xx product '%c%c%c%c' fw %#x, reports %ux%u -> panel %ux%u, polled every %u ms\n",
+	    id[0] ? id[0] : '?', id[1] ? id[1] : ' ', id[2] ? id[2] : ' ', id[3] ? id[3] : ' ', id[4] | (id[5] << 8),
+	    cw, ch, tb->w, tb->h, touch_poll_ms);
+	(void)gt9_write8(GT9_STATUS_REG, 0);
+	st.kind = TOUCH_GOODIX;
+	unsigned errors = 0, reports = 0;
+	for (;;) {
+		touch_wait(touch_poll_ms);
+		/* the chip holds INT active while a report waits; the level differs by config, so the status byte decides */
+		err = touch_read(GT9_ADDR, GT9_STATUS_REG, true, buf, 1);
+		if (err) {
+			if (errors++ < 10) {
+				printf("SWEET TOUCH: status read error %d\n", err);
+			}
+			touch_wait(100);
+			continue;
+		}
+		if (!(buf[0] & 0x80u)) {
+			continue;
+		}
+		unsigned n = buf[0] & 0x0fu;
+		uint32_t mask = 0;
+		int x[TOUCH_MAX], y[TOUCH_MAX];
+		if (n > TOUCH_MAX) {
+			n = 0;
+		}
+		if (n && touch_read(GT9_ADDR, GT9_STATUS_REG + 1, true, buf + 1, 8 * n)) {
+			(void)gt9_write8(GT9_STATUS_REG, 0);
+			continue;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			const uint8_t *c = buf + 1 + 8 * i;
+			unsigned fid = c[0] & 0x0fu;
+			if (fid >= TOUCH_MAX) {
+				continue;
+			}
+			mask |= 1u << fid;
+			x[fid] = (int)((unsigned)(c[1] | (c[2] << 8)) * tb->w / cw);
+			y[fid] = (int)((unsigned)(c[3] | (c[4] << 8)) * tb->h / ch);
+		}
+		if (touch_trace || reports < 5) {
+			printf("SWEET TOUCH: report %u: status %#x mask %#x first %d,%d\n", reports, buf[0], mask,
+			    n ? x[buf[1] & 0xf] : -1, n ? y[buf[1] & 0xf] : -1);
+		}
+		reports++;
+		touch_report(mask, x, y);
+		(void)gt9_write8(GT9_STATUS_REG, 0);
+	}
+out:
+	(void)thread_terminate(current_thread());
+}
+
+void sweet_touch_init_evert(void);
+void
+sweet_touch_init_evert(void)
+{
+	int enabled = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	if (st.started || !enabled) {
+		return;
+	}
+	st.started = true;
+	tb = &touch_evert;
+	touch_poll_ms = 8;
+	(void)PE_parse_boot_argn("sweettouchms", &touch_poll_ms, sizeof(touch_poll_ms));
+	if (touch_poll_ms < 1 || touch_poll_ms > 50) {
+		touch_poll_ms = 8;
+	}
+	(void)PE_parse_boot_argn("sweettouchbb", &bb_half_us, sizeof(bb_half_us));
+	if (bb_half_us < 2 || bb_half_us > 10) {
+		bb_half_us = 5;
+	}
+	(void)PE_parse_boot_argn("sweettouchlog", &touch_trace, sizeof(touch_trace));
+	if (kernel_thread_start(touch_evert_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
