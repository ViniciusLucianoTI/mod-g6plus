--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -263,6 +263,19 @@
 	ml_set_max_cpus(topology->max_cpu_id + 1);
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
 	    topology->num_cpus, topology->num_cpus);
+	{
+		/* patch 1034, test only: sweetsmptest=N resets the SoC (PSCI SYSTEM_RESET) N seconds after a
+		 * complete SMP start, so a host loop can repeat the boot; a failed start stays on screen. */
+		uint32_t smptest = 0;
+		if (PE_parse_boot_argn("sweetsmptest", &smptest, sizeof(smptest)) && smptest) {
+			kprintf("SWEET CPU: SMP TEST PASS, PSCI SYSTEM_RESET in %u s\n", smptest);
+			IOSleep(smptest * 1000);
+			register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+			__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+			    "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+			kprintf("SWEET CPU: PSCI SYSTEM_RESET returned 0x%llx\n", x0);
+		}
+	}
 	thread_terminate(current_thread());
 }
 
@@ -357,6 +370,29 @@
 	/* cpu_start() discards PE_cpu_start's return; do not silently carry on. */
 	if (rc != 0) {
 		panic("SWEET CPU: cpu=%u NOT alive: PSCI CPU_ON rc=%d", getCPUNumber(), rc);
+	}
+	/*
+	 * patch 1034: one CPU_ON at a time. processor_boot() does not wait for the CPU ("so all CPUs can
+	 * start in parallel"), so the next CPU_ON reached the firmware while this core was still coming up.
+	 * On the Moto G6 Plus (SDM630) cpu4, the first core of the second cluster, intermittently never
+	 * entered the kernel that way. Linux brings secondaries up strictly one after the other. Wait until
+	 * this core runs kernel C code (stage 2, arm_init_cpu); it needs none of the caller's locks for that.
+	 * sweetcpuserial=0 restores the parallel start.
+	 */
+	uint32_t serial = 1;
+	PE_parse_boot_argn("sweetcpuserial", &serial, sizeof(serial));
+	if (serial) {
+		uint64_t deadline;
+		nanoseconds_to_deadline(2 * NSEC_PER_SEC, &deadline);
+		while (sweet_cpu_stage_read(getCPUNumber()) < 2) {
+			if (mach_absolute_time() > deadline) {
+				IOLog("SWEET CPU: cpu=%u did not reach arm_init_cpu in 2 s (stage=%u psci_affinity=%d)\n",
+				    getCPUNumber(), sweet_cpu_stage_read(getCPUNumber()),
+				    sweet_psci_affinity_info(cpu->phys_id));
+				break;
+			}
+			IODelay(200);
+		}
 	}
 	return KERN_SUCCESS;
 }
